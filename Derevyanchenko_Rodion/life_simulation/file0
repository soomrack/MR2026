#include <stdio.h>
#include <random>


using RUB = unsigned long long int;
using USD = unsigned long long int;
using Points = unsigned char; // from 0 to 100, used for health, happiness, etc.


struct Person {
    RUB cash;
    RUB salary;
    RUB cash_target;

    RUB total_transport_spent;
    RUB total_hospital_spent;

    Points health;
    Points happiness;

    bool alive;
    
    struct Bank {
        RUB deposit;
        RUB debit_account;
        Points interest_rate;
    };

    Bank AlphaBank;
    Bank VTB;
    Bank Sber;

    struct Car {
        RUB total_gasoline_spent;
        RUB total_repair_spent;
        RUB current_repair_cost;

        double break_chance;

        bool broken;
    };

    Car smartik;
};

using Bank = Person::Bank;


struct Dog {
    RUB food_cost;
    RUB total_food_spent;

    Points health;

    bool exist;

    unsigned int age;
};


struct Cat {
    RUB food_cost;
    RUB total_food_spent;

    int age; // in months
};


Person alice;
Dog bublik;
// Cat fluff;


static std::random_device seed;
static std::mt19937 generator(seed());


Points points_check(int value)
{
    if (value < 0) {
        return 0;
    }

    if (value > 100) {
        return 100;
    }

    return static_cast<Points>(value);
}



// ALICE


void alice_salary(const int year, const int month){
    if (year == 2027 && month == 1) {
        alice.salary = 100'000;    // Promotion

        alice.happiness =
            points_check(alice.happiness + 10);
    }

    alice.cash += alice.salary;
}


void alice_sickness(){
    static std::uniform_int_distribution<RUB> hospital_cost(5'000, 30'000);

    if (alice.health < 20) {

        printf("Alice is very sick, she needs to go to the hospital\n");

        const RUB spent = hospital_cost(generator);

        if (alice.cash >= spent) {

            alice.cash -= spent;
            alice.total_hospital_spent += spent;

            alice.health =
                points_check(alice.health + 10);

            alice.happiness =
                points_check(alice.happiness - 5);

            printf("Hospital spent = %llu, health = %u\n",
                   spent,
                   static_cast<unsigned int>(alice.health));
        }
        else {

            printf("Alice cannot afford the hospital, health is getting worse\n");

            alice.health =
                points_check(alice.health - 5);

            alice.happiness =
                points_check(alice.happiness - 10);
        }
    }
}


void alice_depression(){
    if (alice.happiness < 20) {

        printf("Alice is depressed, she needs to see the psychiatrist\n");

        static std::uniform_int_distribution<RUB> hospital_cost(5'000, 30'000);

        const RUB spent = hospital_cost(generator);

        if (alice.cash >= spent) {

            alice.cash -= spent;
            alice.total_hospital_spent += spent;

            alice.happiness =
                points_check(alice.happiness + 10);

            alice.health =
                points_check(alice.health - 5);

            printf("Hospital spent = %llu, happiness = %u\n",
                   spent,
                   static_cast<unsigned int>(alice.happiness));
        }
        else {

            printf("Alice cannot afford the hospital, happiness is getting worse\n");

            alice.happiness =
                points_check(alice.happiness - 5);

            alice.health =
                points_check(alice.health - 10);
        }
    }
}


void alice_die_from_sickness(){
    if (alice.health == 0) {
        alice.alive = false;

        printf("Alice is dead. Simulation over.\n");
    }
}


// CAR


void alice_car_gas(){
    if (alice.smartik.broken) {
        return;
    }

    std::uniform_int_distribution<RUB> gasoline_cost(8'000, 12'000);

    const RUB spent = gasoline_cost(generator);

    if (alice.cash < spent) {

        alice.happiness =
            points_check(alice.happiness - 3);

        printf("Alice has no money for gasoline\n");

        return;
    }

    alice.cash -= spent;
    alice.smartik.total_gasoline_spent += spent;
}


RUB alice_public_transport_cost()
{
    if ( alice.smartik.broken) {
        return 3'000;
    }

    return 0;
}


void alice_money_transfer(RUB& to, RUB& from, RUB amount){
    if (alice.cash < amount) {
        printf("Alice cannot transfer %llu, not enough cash\n", amount);
        return;
    }
    from -= amount;
    to += amount;
}


void alice_saves_money(){
    if (alice.AlphaBank.deposit < 3'000'000) {
        RUB saving = alice.salary/10;
        alice_money_transfer(alice.AlphaBank.deposit, alice.cash, saving);
    }
    else if (alice.AlphaBank.deposit > 3'000'000 && alice.VTB.deposit < 3'000'000) {   // Alice don't want her money not to be insuranced
        RUB saving = alice.salary/10;
        alice_money_transfer(alice.VTB.deposit, alice.cash, saving);
    }
    else if (alice.VTB.deposit > 3'000'000 && alice.Sber.deposit < 3'000'000){
        RUB saving = alice.salary/10;
        alice_money_transfer(alice.Sber.deposit, alice.cash, saving);
    }
    else {
        // alice_own_buisness() //
    }
}


void alice_bank_interest(Bank& bank, const char* bank_name){
    if (bank.deposit == 0) {
        return;
    }

    const RUB interest = bank.deposit * bank.interest_rate / (12 * 100);

    bank.deposit += interest;

    printf("%s: Alice earned %llu from her deposit\n", bank_name, interest);
}


void alice_public_transport(){
    const RUB transport_cost =
        alice_public_transport_cost();

    if (transport_cost == 0) {
        return;
    }

    if (alice.cash >= transport_cost) {

        alice.cash -= transport_cost;

        alice.total_transport_spent += transport_cost;
    }
    else {

        printf("Alice cannot afford public transport\n");

        alice.happiness =
            points_check(alice.happiness - 3);
    }
}


void alice_car_break(){
    std::uniform_real_distribution<double> chance_roll(0.0, 1.0);
    std::uniform_int_distribution<RUB> repair_cost(10'000, 100'000);


    if (! alice.smartik.broken &&
        chance_roll(generator) <  alice.smartik.break_chance)
    {
        alice.smartik.broken = true;

        alice.smartik.break_chance = 0.0;

        alice.smartik.current_repair_cost =
            repair_cost(generator);

        printf("Alice's car broke down!\n");

        alice.happiness =
            points_check(alice.happiness - 7);
    }


    if ( alice.smartik.broken) {

        if (alice.cash >=  alice.smartik.current_repair_cost) {

            alice.cash -=  alice.smartik.current_repair_cost;

            alice.smartik.total_repair_spent +=
                alice.smartik.current_repair_cost;

            alice.smartik.broken = false;

            alice.smartik.break_chance = 0.0025;

            printf("Car repair spent = %llu\n",
                   alice.smartik.current_repair_cost);
        }
        else {

            printf("Alice cannot afford car repair, she is forced to use public transport\n");

            alice.happiness =
                points_check(alice.happiness - 5);
        }
    }
    else {

        alice.smartik.break_chance += 0.0025;

        if (alice.smartik.break_chance > 1.0) {
            alice.smartik.break_chance = 1.0;
        }
    }
}

void alice_cash_management(RUB& debit_account, const char* account_name){
    if (alice.cash > alice.cash_target) {
        const RUB excess = alice.cash - alice.cash_target;

        alice.cash    -= excess;
        debit_account += excess;

        printf("Moved %llu to %s (cash = %llu)\n",
               excess, account_name, alice.cash);
    }
    else if (alice.cash < alice.cash_target) {
        const RUB needed = alice.cash_target - alice.cash;

        if (debit_account >= needed) {
            debit_account -= needed;
            alice.cash    += needed;

            printf("Withdrew %llu from %s (cash = %llu)\n",
                   needed, account_name, alice.cash);
        }
        else {
            const RUB taken = debit_account;

            alice.cash    += taken;
            debit_account  = 0;

            printf("Withdrew all %llu from %s, "
                   "cash below target (cash = %llu)\n",
                   taken, account_name, alice.cash);
        }
    }
}


void alice_cars(){
    alice_car_break();
    alice_car_gas();  //
}


// DOG

void bublik_die(){
    if (!bublik.exist) {
        return;
    }

    bublik.exist = false;

    printf("Bublik died at %d months.\n",
           bublik.age);

    alice.happiness =
        points_check(alice.happiness - 20);
}


void bublik_give_away(){
    if (!bublik.exist) {
        return;
    }

    bublik.exist = false;

    printf("Bublik left for new home. Good luck!\n");

    alice.happiness =
        points_check(alice.happiness - 8);
}


void bublik_age(){
    if (!bublik.exist) {
        return;
    }

    ++bublik.age;

    alice.happiness =
        points_check(alice.happiness - 1);

    if (bublik.age >= 180) {
        bublik_die();
    }
}


void bublik_food(){
    if (!bublik.exist) {
        return;
    }

    if (alice.cash >= bublik.food_cost) {

        alice.cash -= bublik.food_cost;

        bublik.total_food_spent +=
            bublik.food_cost;
    }
    else {

        alice.happiness =
            points_check(alice.happiness - 5);

        bublik.health =
            points_check(bublik.health - 10);

        printf("Alice cannot afford Bublik food, Bublik health is getting worse\n");
    }
}


