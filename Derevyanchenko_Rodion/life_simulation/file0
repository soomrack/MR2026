void bublik_age(){
    if (!bublik.exist) {
        return;
    }

    ++bublik.age;

    alice.happiness = points_check(alice.happiness - 1);

    if (bublik.age >= 180) {
        bublik_die();
    }
}


void bublik_food(){
    if (!bublik.exist) {
        return;
    }

    if (alice.cash >= bublik.food_cost) {

        alice.cash -= bublik.food_cost;
        bublik.total_food_spent += bublik.food_cost;
    }
    else {
        alice.happiness = points_check(alice.happiness - 5);
        bublik.health = points_check(bublik.health - 10);

        printf("Alice cannot afford Bublik food, Bublik health is getting worse\n");
    }
}


