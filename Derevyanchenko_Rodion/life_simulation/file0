void transfer(Account& from, Account& to, RUB amount){
    if (from.balance < amount) {
        printf("Transfer failed: cannot send %llu from %s to %s (only %llu available)\n",
               amount, from.name.c_str(), to.name.c_str(), from.balance);
        return;
    }

    from.balance -= amount;
    to.balance    += amount;

    printf("Transferred %llu from %s to %s\n",
           amount, from.name.c_str(), to.name.c_str());
}


