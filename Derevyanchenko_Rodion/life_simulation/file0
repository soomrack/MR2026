}


void alice_car_gas(){
    if (alice.smartik.is_broken) return;

    std::uniform_int_distribution<RUB> gasoline_cost(8'000, 12'000);

    const RUB spent = gasoline_cost(generator);

    if (alice.cash < spent) {
        alice.happiness = points_check(alice.happiness - 3);
        printf("Alice has no money for gasoline\n");
        return;
    }

    alice.cash -= spent;
    alice.FNS.gasoline_spent += spent;
    fns_record_expense(spent);
}


