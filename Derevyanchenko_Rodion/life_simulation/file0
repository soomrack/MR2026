Points points_check(int value)
{
    if (value < 0) return 0;

    if (value > 100)return 100;

    return static_cast<Points>(value);
}



// ALICE


void alice_salary(const int year, const int month){
    if (year == 2027 && month == 1) {
        alice.salary = 100'000; //promotion
        alice.happiness = points_check(alice.happiness + 10);
    }

    alice.cash += alice.salary;
    alice.FNS.salary_income += alice.salary;
    alice.FNS.total_income  += alice.salary;
}


void fns_record_expense(RUB amount) {
    alice.FNS.total_expenses += amount;
    alice.FNS.current_month_expenses += amount;
}


void fns_roll_month() {
    alice.FNS.monthly_expenses[alice.FNS.history_index] = alice.FNS.current_month_expenses; // Record the current month's expenses
    alice.FNS.history_index = (alice.FNS.history_index + 1) % 12;   // Move to the next month in the circular buffer

    if (alice.FNS.months_recorded < 12) ++alice.FNS.months_recorded;

    alice.FNS.current_month_expenses = 0;
}

RUB fns_avg_monthly_expenses() {
    if (alice.FNS.months_recorded == 0) return 0;

    RUB sum = 0;
    for (int i = 0; i < 12; ++i) sum += alice.FNS.monthly_expenses[i];
    return sum / alice.FNS.months_recorded;
}


void alice_sickness() {
    if (alice.health >= 20) return;

    static std::uniform_int_distribution<RUB> hospital_cost(5'000, 30'000);

    printf("Alice is very sick, she needs to go to the hospital\n");

    const RUB spent = hospital_cost(generator);

    if (alice.cash >= spent) {
        alice.cash -= spent;
        alice.FNS.hospital_spent += spent;
        fns_record_expense(spent);

        alice.health = points_check(alice.health + 10);
        alice.happiness = points_check(alice.happiness - 5);

        printf("Hospital spent = %llu, health = %u\n", spent, static_cast<unsigned int>(alice.health));
    }
    else {
        printf("Alice cannot afford the hospital, health is getting worse\n");

        alice.health    = points_check(alice.health - 5);
        alice.happiness = points_check(alice.happiness - 10);
    }
}


void alice_depression() {
    if (alice.happiness >= 20) return;

    static std::uniform_int_distribution<RUB> hospital_cost(5'000, 30'000);

    printf("Alice is depressed, she needs to see the psychiatrist\n");

    const RUB spent = hospital_cost(generator);

    if (alice.cash >= spent) {
        alice.cash -= spent;
        alice.FNS.hospital_spent += spent;
        fns_record_expense(spent);

        alice.happiness = points_check(alice.happiness + 10);
        alice.health = points_check(alice.health - 5);

        printf("Hospital spent = %llu, happiness = %u\n", spent, static_cast<unsigned int>(alice.happiness));
    }
    else {
        printf("Alice cannot afford the hospital, happiness is getting worse\n");

        alice.happiness = points_check(alice.happiness - 5);
        alice.health = points_check(alice.health - 10);
    }
}


void alice_die_from_sickness(){
    if (alice.health == 0) {
        alice.alive = false;
        printf("Alice is dead. Simulation over.\n");
