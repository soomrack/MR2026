void alice_interest_income(Bank& bank, const char* bank_name){
    if (bank.deposit.balance == 0) return;

    const RUB interest = bank.deposit.balance * bank.interest_rate / (12 * 100);
    bank.deposit.balance += interest;
    alice.FNS.total_income += interest;

    printf("%s: Alice earned %llu from her deposit\n", bank_name, interest);
}


void alice_public_transport(){
    const RUB transport_cost =
        alice_public_transport_cost();

    if (transport_cost == 0) return;

    if (alice.cash >= transport_cost) {
        alice.cash -= transport_cost;
        alice.FNS.transport_spent += transport_cost;
        fns_record_expense(transport_cost);
    }
    else {

        printf("Alice cannot afford public transport\n");

        alice.happiness = points_check(alice.happiness - 3);
    }
}


void alice_car_break(){
    std::uniform_real_distribution<double> chance_roll(0.0, 1.0);
    std::uniform_int_distribution<RUB> repair_cost(10'000, 100'000);

    if (!alice.smartik.is_broken) {
        alice.smartik.break_chance += 0.0025;
        if (alice.smartik.break_chance > 1.0) {
            alice.smartik.break_chance = 1.0;
        }
    }

    if (!alice.smartik.is_broken &&
        chance_roll(generator) < alice.smartik.break_chance)
    {
        alice.smartik.is_broken = true;
        alice.smartik.break_chance = 0.0;
        alice.smartik.current_repair_cost = repair_cost(generator);

        printf("Alice's car broke down!\n");
        alice.happiness = points_check(alice.happiness - 7);
    }

    if (alice.smartik.is_broken) {
        if (alice.cash >= alice.smartik.current_repair_cost) {
            alice.cash -= alice.smartik.current_repair_cost;
            alice.FNS.repair_spent += alice.smartik.current_repair_cost;
            fns_record_expense(alice.smartik.current_repair_cost);

            alice.smartik.is_broken = false;
            alice.smartik.break_chance = 0.0025;

            printf("Car repair spent = %llu\n", alice.smartik.current_repair_cost);
        }
        else {
            printf("Alice cannot afford car repair, she is forced to use public transport\n");
            alice.happiness = points_check(alice.happiness - 5);
        }
    }
}

