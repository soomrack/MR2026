    }

    bublik.exist = false;

    printf("Bublik died at %d months.\n", bublik.age);

    alice.happiness = points_check(alice.happiness - 20);
}


void bublik_give_away(){
    if (!bublik.exist) {
        return;
    }

    bublik.exist = false;

    printf("Bublik left for new home. Good luck!\n");

    alice.happiness = points_check(alice.happiness - 8);
