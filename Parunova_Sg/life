void work(Person& alice){
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<double> dis(0.0, 1.0);
    if (!alice.work){
        if (dis(gen)<= alice.findworkPercent) {
            alice.work = true;
            alice.salary = 100'000;
            std::cout << alice.name << " нашла работу "
                      << "Зарплата: " << alice.salary << "\n";
        }
    }

    if (!alice.work){
        if(dis(gen)<= alice.gocoursesPercent){
            alice.findworkPercent *=1.2;
            ++alice.countCourses;
            std::cout << alice.name << " решила пройти курсы проф переподготовки."
                      <<" шанс найти работу увеличен.\n ";
        }
    }
   
    if (alice.work){
        ++alice.mEmploeyed;
        if (alice.mEmploeyed % 12 ==0){
            ++alice.yEmploeyed;
        }

        if (globalMonth == 1){
            alice.salary = static_cast<RUB>(alice.salary * (1 + alice.inflationPercent));
        }

        if (alice.yEmploeyed % 10 ==0 && alice.mEmploeyed % 12 == 0){
            alice.salary = alice.salary * alice.growSalarycourses;
        ++alice.countCourses;
        std::cout << alice.name << " направили на курсы повышения квалификации "
                  << "за такие движения ей повысят зарплату " << alice.salary << "\n";
        }
        
        addMoney(alice, alice.salary, "зарплата");
    }
}   

