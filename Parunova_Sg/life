const std::map<season, double> seasonMulti={
    {season::Winter, 1.074},
    {season::Autumn, 1.044},
    {season::Summer, 0.99},
    {season::Spring, 0.95},
};

RUB foodCost(food& infFood){
    unsigned int yearsSinceBase = globalYears - 2027;

    if(yearsSinceBase> infFood.yearfoodInflation.size()){
        yearsSinceBase= static_cast<unsigned int>(infFood.yearfoodInflation.size());
    }

    double inflationMultiplier = 1.0;
    for (unsigned int i = 1; i < yearsSinceBase; ++i) {
        inflationMultiplier *= infFood.yearfoodInflation[i];
    }

    season Season= getSeason(globalMonth);
    double seasonfoodMultiplier = seasonMulti.at(Season);

    return static_cast<RUB>(infFood.basefoodBasket *inflationMultiplier*seasonfoodMultiplier);
}

