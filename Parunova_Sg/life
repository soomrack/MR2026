void addMoney (Person& alice, RUB amount, const std::string& reason =""){
    if (amount == 0){
        return;
    }

    alice.cash+=amount;

    if(!reason.empty()){
        std::cout << "  +" << amount << " (" << reason << ")\n";
    }
}

bool spendMoney (Person&alice, RUB amount, const std::string& reason= "", bool log =true){
    if (amount == 0){
        return true;
    }

    if (alice.cash < amount) {
        if (log) {
            std::cout << " Недостаточно денег: нужно " << amount
                      << " (" << reason << ")\n";
        }
        return false;
    }

    alice.cash -= amount;

    if (log && !reason.empty()) {
        std::cout << "  -" << amount << " (" << reason << ") \n";
    }
    return true;
}

// Здоровье

struct diseasesScore{
    double young_probability; /// 20 лет
    double old_factorPercent;///65 старость 
    double damage;//по месяцам
    double inflationCost;//по годам 
    RUB baseCost;
};

std::map <diseases, diseasesScore> diseasesChance={
    {diseases::hypertension, {0.02, 0.00045, 2.0, 1.0476, 3000}}, //ЖНВЛП
    {diseases::osteochondrosis, {0.04, 0.000125, 0.2, 1.11, 6000}}, //частично, но в общем не ЖНВЛП
    {diseases::gastritis, {0.025, 0.0004, 0.5, 1.0476, 4000}}, //ЖНВЛП~
    {diseases::diabetes, {0.017, 0.00004, 3.0, 1.0476, 8900}}, //прям ЖНВЛП
};

std::string getDiseaseName(diseases disease) {
    switch (disease) {
        case diseases::hypertension: return "Гипертония";
        case diseases::osteochondrosis: return "Остеохондроз";
        case diseases::gastritis:return "Гастрит";
        case diseases::diabetes:return "Диабет";
    }
}

double mathProbability(Person& person, diseases dDisease) {
    auto it = diseasesChance.find(dDisease);
    if (it == diseasesChance.end()) {
        return 0.0; 
    }

    const auto& stats = it->second;
    double finalProb = stats.young_probability;

    for (years Age= 20 ; Age < person.Age; ++Age) {
        for (month mAge = 1; mAge<=12; ++mAge){
            finalProb += stats.old_factorPercent;
            if (finalProb  > 1.0) {
                finalProb = 1.0;
                break; 
            }   
        }
    }
        return finalProb;    
}

RUB monthlyCost(diseases rDiseases){
    auto it = diseasesChance.find(rDiseases);
    if (it==diseasesChance.end()){
        return 0.0; 
    }
    
     const auto& stats = it->second;

     unsigned int yearsSinceBase = globalYears - 2027;

     double inflationMultiplier = 1.0;
     for (int i = 0; i < yearsSinceBase; ++i) {
        inflationMultiplier *= stats.inflationCost;
     }

     return static_cast<RUB>(stats.baseCost * inflationMultiplier);
        
}

bool tryStartTreatment(Person& alice, diseases tryDeseas){
    RUB monthly = monthlyCost(tryDeseas);

    if (alice.cash < monthly){
        std::cout << "  Денег на лечение (" << monthly
                  << " руб/мес) не хватает.\n";
        return false;
    }

    treatmentCost treat;
    treat.Disease = tryDeseas;
    treat.monthlyPayment = monthly;
    treat.remainingMonthPaid = globalMonthTreatment - 1;
    alice.activeTreatment.push_back(treat);
    return true;

}

void payTreatment (Person& alice){
    for (auto it= alice.activeTreatment.begin();
         it != alice.activeTreatment.end();){

            RUB monthly = it->monthlyPayment;

            if (!spendMoney(alice, monthly,
                        "лечение " + getDiseaseName(it->Disease))) {
            std::cout << "  Лечение " << getDiseaseName(it->Disease)
                      << " прервано.\n";
            it = alice.activeTreatment.erase(it);
            continue;
            }

         alice.healingExpenses += monthly;
         --it-> remainingMonthPaid;

         if (it->remainingMonthPaid <= 0) {
            alice.activeDiseases.erase(
                std::remove(alice.activeDiseases.begin(),
                            alice.activeDiseases.end(),
                            it->Disease),
                alice.activeDiseases.end());

            std::cout << "  " << getDiseaseName(it->Disease)
                      << " вылечен!\n";

           it = alice.activeTreatment.erase(it);
        } 

        else {
            ++it;
        }
    }
}

void health(Person& alice) {
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<double> dis(0.0, 1.0);

        for (const auto& [diseaseType, stats] : diseasesChance) {
            auto alreadyHas = std::find(alice.activeDiseases.begin(), alice.activeDiseases.end(), diseaseType);
            
            if (alreadyHas != alice.activeDiseases.end()) {
                continue; 
            }

            double currentChance = mathProbability(alice, diseaseType);
            double roll = dis(gen); 

            if (roll <= currentChance) {
                alice.activeDiseases.push_back(diseaseType);
                std::cout << "Обнаружен " << getDiseaseName(diseaseType)  
                          << " Шанс был: " << (currentChance * 100) << "% ";
                tryStartTreatment(alice, diseaseType);
            }
        }
        
        for (const auto& disease : alice.activeDiseases) {
            bool beingTreated = false;
            for (const auto& act : alice.activeTreatment) {
                if (act.Disease == disease) {
                    beingTreated = true;
                    break;
                }
            }
            if (beingTreated) continue;

            RUB monthly = monthlyCost(disease);
            if (alice.cash < monthly) continue;

            if (tryStartTreatment(alice, disease)) {
                std::cout << "  Возобновлена попытка лечения "
                        << getDiseaseName(disease) << "\n";
            }
        }

        payTreatment(alice);
        bool damageDealt = false;

        if (!alice.activeDiseases.empty()) {
            std::cout << " Текущее состояние здоровья: \n";

            for (const auto& disease : alice.activeDiseases) {
                bool beingTreated = false;
                for (const auto& t : alice.activeTreatment){
                    if (t.Disease == disease) {
                    beingTreated = true;
                    break;
                    }
                }

                if (beingTreated) {
                    std::cout << getDiseaseName(disease)
                            << " В процессе лечения\n";
                    continue;
                }

                auto it = diseasesChance.find(disease);
                if (it != diseasesChance.end()) {
                    alice.health -= it->second.damage;
                    damageDealt = true;    

                    std::cout << getDiseaseName(disease) 
                              << " не излечен " << "\n";
              
                }
            }
        }

        if (damageDealt) {
            std::cout << "Итоговое здоровье: " << alice.health << "\n\n";
        }

        if (alice.health <= 0) {
            std::cout << alice.name << " Скончалась от болезней в возрасте " << alice.Age << " лет. \n";
            return;
        }

}

//Конец всякому здоровью

// Работа

void work(Person& alice){
    std::random_device rd;
    std::mt19937 gen(rd());
    std::uniform_real_distribution<double> dis(0.0, 1.0);
    if (!alice.work){
        if (dis(gen)<= alice.findworkPercent) {
            alice.work = true;
            alice.salary = 100'000;
            std::cout << alice.name << " нашла работу "
                      << "Зарплата: " << alice.salary << "\n";
        }
    }

    if (!alice.work){
        if(dis(gen)<= alice.gocoursesPercent){
            alice.findworkPercent *=1.2;
            ++alice.countCourses;
            std::cout << alice.name << " решила пройти курсы проф переподготовки."
                      <<" шанс найти работу увеличен.\n ";
        }
    }
   
    if (alice.work){
        ++alice.mEmploeyed;
        if (alice.mEmploeyed % 12 ==0){
            ++alice.yEmploeyed;
        }

        if (globalMonth == 1){
            alice.salary = static_cast<RUB>(alice.salary * (1 + alice.inflationPercent));
        }

        if (alice.yEmploeyed % 3 ==0 && alice.mEmploeyed % 12 == 0){
            alice.salary = alice.salary * alice.growSalarycourses;
        ++alice.countCourses;
        std::cout << alice.name << " направили на курсы повышения квалификации "
                  << "за такие движения ей повысят зарплату " << alice.salary << "\n";
        }
        
        addMoney(alice, alice.salary, "зарплата");
    }
}   

// Календарь симуляции 

void simulate(Simulation& Sim) {
    std::cout << "Старт " << Sim.alice.name 
              << " (Возраст: " << Sim.alice.Age << " лет) \n\n";
    globalYears = 2027;
    globalMonth = 1;

    while (not (globalYears == 2057 && globalMonth == 1)) {

        std::cout << globalYears << " год " << globalMonth
                  << " мес. \n";

        Sim.alice.growingUp();          
        work(Sim.alice);
        health(Sim.alice);

        if (Sim.alice.health <=0) {
        std::cout << " Земля ей помидором.\n";
        break;
        }

        ++globalMonth;
        if (globalMonth == 13){
            ++globalYears;
            globalMonth =1;
        }

        std::cout << "  на счету: " << Sim.alice.cash << " руб.\n\n";
    }
    
    if (Sim.alice.health > 0) {
        std::cout << "Конец \n";
        std::cout << Sim.alice.name << " Выжила. Оставшееся здоровье: " << Sim.alice.health << "\n";
    }
}

int main() {
    Simulation Sim{};
    simulate(Sim);
};
