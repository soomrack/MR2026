}

RUB rentCost(rent& infRent) {
    unsigned int yearsSinceBase = globalYears - 2027;

    if (yearsSinceBase > infRent.yearlyInflation.size()) {
        yearsSinceBase = static_cast<unsigned int>(infRent.yearlyInflation.size());
    }

    double inflationMultiplier = 1.0;
    for (unsigned int i = 1; i < yearsSinceBase; ++i) {
        inflationMultiplier *= infRent.yearlyInflation[i];
    }

    return static_cast<RUB>(infRent.baserentCost * inflationMultiplier);
}

