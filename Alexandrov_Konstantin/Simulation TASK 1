void alice_food(const int year, const int month) {

	static RUB food_cost = 20'000;
	static RUB coffee_cost = 3'000;
	static RUB restaurant_cost = 5'000;
	static RUB delivery_cost = 2'000;

	inflation.food = 1;
	if (chance(20)) {
		inflation.food += 0.04;
	}
	if (chance(5)) {
		inflation.food -= 0.01;
	}
	if (chance(1)) {
		inflation.food -= 0.02;
	}

	RUB total = 0;
	alice.cash -= food_cost;
	total += food_cost;

	if (alice.cash >= coffee_cost) { //morning coffe
		alice.cash -= coffee_cost;
		total += coffee_cost;
	}
	else if (alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= coffee_cost) {
		alice_deposit_reserve(coffee_cost);
		total += coffee_cost;
	}

	if (alice.cash >= restaurant_cost) {
		alice.cash -= restaurant_cost; // restaurant once a month
		total += restaurant_cost;
		alice.mood += 0.01;
	}
	else if (alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= restaurant_cost) {
		alice_deposit_reserve(restaurant_cost);
		total += restaurant_cost;
	}

	if (month % 2 == 0 and alice.cash >= delivery_cost) {
		alice.cash -= delivery_cost; // delivery
		total += delivery_cost;
		alice.mood += 0.01;
		alice.health += 0.01;
	}
	else if (alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= delivery_cost) {
		alice_deposit_reserve(delivery_cost);
		total += delivery_cost;
	}
	alice.food += total;
	total = 0;
}

