			alice.health -= 0.02;
		}
		if (month == 6) {
			alice.mood += 0.05; //Happy birthdsy
		}
	}
	void alice_health(const int year, const int month) {
		const RUB doctor_cost = 1'000;
		const RUB pills_cost = 5'000;
		const RUB desponcerisatia_cost = 3'000;

		RUB total = doctor_cost + pills_cost;

		if (chance(5)) {
			alice.health -= 0.03; // random illness
			if (alice.cash >= total) {
				alice.cash -= total;
				alice.health += 0.03;
				alice.mood += 0.02;
			}
			else if (alice.cash < total and alice.deposit >= total) {
				alice_reserve(total);
				alice.health += 0.03;
				alice.mood += 0.02;
			}
			else {
				alice.mood -= 0.05;
			}
		}
		if (chance(1)) { // serious random illness
			alice.health -= 0.15;
			RUB hospital = rand_rub(20'000, 100'000);
			if (alice.cash >= hospital) {
				alice.cash -= hospital;
				alice.health += 0.15;
			}
			else if (alice.cash < hospital and alice.deposit >= hospital) {
				alice_reserve(hospital);
				alice.cash -= hospital;
				alice.health += 0.15;
			}
			else {
				alice.health -= 0.9;
				alice.mood -= 0.3;
			}
		}
		if (alice.health <= 0.60) {
			if (alice.cash >= total) {
				alice.cash -= total;
				alice.health += 0.10;
				alice.mood += 0.02;
			}
			else if (alice.cash < total and alice.deposit >= total) {
				alice_reserve(total);
				alice.health += 0.10;
				alice.mood += 0.02;
			}
			else {
				alice.health -= 0.05;
				alice.mood -= 0.05;
			}
		}
		if (month == 3 and alice.cash >= desponcerisatia_cost) {
			alice.cash -= desponcerisatia_cost;
			alice.health += 0.05;
		}
		else if (month == 3 and alice.deposit >= desponcerisatia_cost) {
			alice_reserve(total);
			alice.health += 0.10;
			alice.mood += 0.02;
		}
		if (alice.mood >= 1) {
			alice.mood -= 0.3;
			alice.health += 0.1;
		}
		else if (alice.mood <= 0) {
			alice.mood += 0.3;
			alice.health -= 0.1;
		}
		if (alice.health > 1.0) {
			alice.health = 1.0;
		}
		if (alice.health < 0.0) {
			alice.health = 0.0;
		}

	}
