void alice_seasons(const int year, const int month) { //changes between seasons
	if (month == 12 || month == 1 || month == 2) {
		alice.mood -= 0.01;
		alice.health -= 0.02;
	}

	if (month == 3 || month == 4 || month == 5) {
		alice.mood += 0.01;
		alice.health += 0.01;
	}

	if (month == 6 || month == 7 || month == 8) {
		alice.mood += 0.01;
		alice.health += 0.01;
	}

	if (month == 9 || month == 10 || month == 11) {
		alice.mood -= 0.01;
		alice.health -= 0.02;
	}

	if (month == 6) {
		alice.mood += 0.05; //Happy birthdsy
	}
}

void alice_health(const int year, const int month) {

	static RUB doctor_cost = 1'000;
	static RUB pills_cost = 5'000;
	static RUB desponcerisatia_cost = 3'000;

	RUB total = doctor_cost + pills_cost;

	if (chance(5)) {
		alice.health -= 0.03; // random illness
		if (alice.cash >= total) {
			alice.cash -= total;
			alice.health += 0.03;
			alice.mood += 0.01;
		}
		else if (alice.cash < total and alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= total) {
			alice_deposit_reserve(total);
			alice.health += 0.03;
			alice.mood += 0.01;
		}
		else {
			alice.mood -= 0.05;
		}
	}

	if (chance(1)) { // serious random illness

		alice.health -= 0.15;
		RUB hospital = rand_rub(20'000, 100'000);
		if (alice.cash >= hospital) {
			alice.cash -= hospital;
			alice.health += 0.15;
		}
		else if (alice.cash < hospital and alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= hospital) {
			alice_deposit_reserve(hospital);
			alice.cash -= hospital;
			alice.health += 0.15;
		}
		else {
			alice.health -= 0.9;
			alice.mood -= 0.3;
		}
	}

	if (alice.health <= 0.60) {
		if (alice.cash >= total) {
			alice.cash -= total;
			alice.health += 0.10;
			alice.mood += 0.02;
		}
		else if (alice.cash < total and alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= total) {
			alice_deposit_reserve(total);
			alice.health += 0.10;
			alice.mood += 0.02;
		}
		else {
			alice.health -= 0.05;
			alice.mood -= 0.05;
		}
	}

	if (month == 3 and alice.cash >= desponcerisatia_cost) {
		alice.cash -= desponcerisatia_cost;
		alice.health += 0.05;
	}
	else if (month == 3 and alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= desponcerisatia_cost) {
		alice_deposit_reserve(total);
		alice.health += 0.10;
		alice.mood += 0.02;
	}

	if (alice.mood >= 1) {
		alice.mood -= 0.3;
		alice.health += 0.1;
	}
	else if (alice.mood <= 0) {
		alice.mood += 0.3;
		alice.health -= 0.1;
	}

	if (alice.health > 1.0) {
		alice.health = 1.0;
	}

	if (alice.health < 0.0) {
		alice.health = 0.0;
	}
}

