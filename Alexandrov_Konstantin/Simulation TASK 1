bool chance(int Percent) {
	std::uniform_int_distribution<int> between(1, 500);
	return between(rng) <= Percent; // сравнивает и возвращает false или true взависимости от сравнения
}
RUB rand_rub(RUB lower, RUB higher) { // случайные деньги 
	std::uniform_int_distribution<RUB> between(lower, higher);
	return between(rng);
}

void russia_inflation(const int year, const int month) {
	russia.inflation += 0.01;
	if (chance(5)) {
		russia.inflation += 0.01;
	}

	if (chance(5)) {
		russia.inflation -= 0.01;
	}

	if (russia.inflation < 0.0) {
		russia.inflation = 0.0;
	}
}

void Bank_system(const int year, const int month) {

	alice.bank.CB_key_rate = russia.inflation + 0.02;

	//Для альфы
	alice.bank.Alfa_deposit_rate = alice.bank.CB_key_rate - 0.01;
	alice.bank.Alfa_credit_rate = alice.bank.CB_key_rate + 0.03;

	//дЛя БСПБ
	alice.bank.BSPB_deposit_rate = alice.bank.CB_key_rate - 0.02;
	alice.bank.BSPB_credit_rate = alice.bank.CB_key_rate + 0.06;
}

void alice_deposit_reserve(RUB total) { // Если не хватает денег, то берём с накопительного

	if (alice.bank.Alfa_deposit_rate <= alice.bank.BSPB_deposit_rate and total < alice.bank.Alfa_deposit) {
		alice.bank.Alfa_deposit -= total;
	}
	else if (alice.bank.Alfa_deposit_rate >= alice.bank.BSPB_deposit_rate and total < alice.bank.BSPB_deposit) {
		alice.bank.BSPB_deposit -= total;
	}
	else if (alice.bank.Alfa_deposit_rate <= alice.bank.BSPB_deposit_rate and total < alice.bank.Alfa_deposit + alice.bank.BSPB_deposit) {
		total = total - alice.bank.Alfa_deposit; // списываем сколько можем с альфы а потом с бспб
		alice.bank.Alfa_deposit = 0;
		alice.bank.BSPB_deposit -= total;
	}
	else if (alice.bank.Alfa_deposit_rate >= alice.bank.BSPB_deposit_rate and total < alice.bank.Alfa_deposit + alice.bank.BSPB_deposit) {
		total = total - alice.bank.BSPB_deposit; // списываем сколько можем с бспб а потом с альфы
		alice.bank.BSPB_deposit = 0;
		alice.bank.Alfa_deposit -= total;
	}
}

void alice_salary(const int year, const int month) {

	inflation.salary = 1;

	if (chance(10)) {
		inflation.salary += 0.02;
	}

	if (chance(5)) {
		inflation.salary -= 0.01;
	}

	if (year % 2 == 0 and month == 9) {
		alice.salary = 125'000;
	}

	alice.cash += alice.salary * inflation.salary;

	if (month != 7 and alice.mood > 0.5) { // Во время отпуска без премии
		alice.cash += 10'000 * alice.health; // Премия
		alice.mood -= 0.03;
	}
}


void alice_deposit(const int year, const int month) {

	alice.bank.Alfa_deposit = ((alice.bank.Alfa_deposit_rate * alice.bank.Alfa_deposit) / 12) + alice.bank.Alfa_deposit;
	alice.bank.BSPB_deposit = ((alice.bank.BSPB_deposit_rate * alice.bank.BSPB_deposit) / 12) + alice.bank.BSPB_deposit;

	if (alice.cash > 0) {
		int ostatok = alice.cash * 0.25;
		if (alice.cash >= alice.salary) {
			alice.cash -= ostatok;
			if (alice.bank.Alfa_deposit_rate >= alice.bank.BSPB_deposit_rate) {
				alice.bank.Alfa_deposit += ostatok;
			}
			else {
				alice.bank.BSPB_deposit += ostatok;
			}
		}
	}
}


void alice_car(const int year, const int month) {

	static RUB oil_cost = 10'000;
	static RUB tires_cost = 4'000;
	static RUB TI_cost = 20'000;
	static RUB insurance_cost = 15'000;
	static RUB wash_cost = 1'000;
	static RUB Metro = 1'500;

	inflation.car = 1;

	if (chance(20)) {
		inflation.car += 0.04;
	}

	if (chance(5)) {
		inflation.car -= 0.01;
	}

	if (chance(1)) {
		inflation.car -= 0.02;
	}

	RUB total = oil_cost;

	if (alice.car.Hudai == 1) {

		if (month == 11 || month == 2) {
			total += tires_cost;      // tires change
		}

		if (month == 6) {
			total += TI_cost;         // technical inspection
		}

		if (month == 9) {
			total += insurance_cost;  // insurance - страховка
		}

		if (month % 2 == 0) {
			total += wash_cost;       // wash once per 2 month
		}

		if (alice.cash >= total) {
			alice.cash -= total;
			alice.car.car_spend += total;
			alice.car.Hudai = true;
			alice.mood += 0.1;
		}
		else if (alice.cash < total and alice.bank.Alfa_deposit + alice.bank.BSPB_deposit >= total) {
			alice_deposit_reserve(total);
			alice.car.car_spend += total;
			alice.car.Hudai = true;
			alice.mood += 0.1;
		}
		else {
			alice.car.Hudai = false;
		}
	}

	if (alice.cash > Metro and alice.car.Hudai == false) { // no car - metro
		alice.cash -= Metro;
		alice.health -= 0.01;
	}
	else if (alice.cash < Metro and alice.car.Hudai == false) { //no car n metro - walk
		alice.mood -= 0.1;
	}

}

