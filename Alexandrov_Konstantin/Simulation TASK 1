		alice.mood += 0.01;
	}
	else if (alice.deposit >= care_cost) {
		alice_reserve(care_cost);
		total += care_cost;
		alice.mood += 0.01;
	}
	else {
		alice.mood -= 0.05;
	}
	if (month == 11 and alice.cash >= winter_clothes_cost) {
		alice.cash -= winter_clothes_cost;
		total += winter_clothes_cost;
		alice.health += 0.05;
		alice.mood += 0.01;
	}
	else if (month == 11 and alice.deposit >= winter_clothes_cost) {
		alice_reserve(winter_clothes_cost);
		total += winter_clothes_cost;
		alice.health += 0.05;
		alice.mood += 0.01;
	}
	else {
		alice.mood -= 0.05;
		alice.health -= 0.1;
	}
	if (month == 5 and alice.cash >= summer_clothes_cost) {
		alice.cash -= summer_clothes_cost;
		total += summer_clothes_cost;
		alice.health += 0.01;
		alice.mood += 0.01;
	}
	else if (month == 5 and alice.deposit >= summer_clothes_cost) {
		alice_reserve(summer_clothes_cost);
		total += summer_clothes_cost;
		alice.health += 0.01;
		alice.mood += 0.01;
	}
	else {
		alice.mood -= 0.05;
	}
	if ((month == 3 || month == 9) and alice.cash >= boots_cost) {
		alice.cash -= boots_cost;
		total += boots_cost;
		alice.health += 0.01;
		alice.mood += 0.01;
	}
	else if ((month == 3 || month == 9) and alice.deposit >= summer_clothes_cost) {
		alice_reserve(boots_cost);
		total += boots_cost;
		alice.health += 0.01;
		alice.mood += 0.01;
	}
	else {
		alice.mood -= 0.05;
		alice.beauty += total;
	}
}

	void alice_seasons(const int year, const int month) { //changes between seasons
		if (month == 12 || month == 1 || month == 2) {
			alice.mood -= 0.01;
			alice.health -= 0.02;
		}
		if (month == 3 || month == 4 || month == 5) {
			alice.mood += 0.01;
			alice.health += 0.01;
		}
		if (month == 6 || month == 7 || month == 8) {
			alice.mood += 0.01;
			alice.health += 0.01;
		}
		if (month == 9 || month == 10 || month == 11) {
