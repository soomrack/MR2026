void purchases_step(Person& p, Purchase* items, int count, char* comment,
                    int year, int month) {
    for (int i = 0; i < count; ++i) {
        if (items[i].bought) continue;
        if (items[i].year != year || items[i].month != month) continue;

        if (p.cash >= items[i].price) p.cash -= items[i].price;
        else p.cash = 0;

        items[i].bought = 1;
        char tmp[160];
        snprintf(tmp, sizeof(tmp), "%s за %llu₽", items[i].item, items[i].price);
        append_comment(comment, tmp);
    }
}


 
