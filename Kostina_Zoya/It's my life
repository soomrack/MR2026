    append_comment(comment, tmp);
}


 
//  ЗАКРЫТИЕ БИЗНЕСА БОБА
 

void close_bob_business(Person& p, char* comment) {
    if (!bob_laundry.opened || bob_laundry.closed) return;

    bob_laundry.closed = 1;
    bob_laundry.opened = 0;

    RUB salvage = bob_laundry.open_cost * 40 / 100;
    p.cash += salvage;

    RUB debt = bob_laundry.loan;
    if (p.cash >= debt) { p.cash -= debt; debt = 0; }
    else { debt -= p.cash; p.cash = 0; }

    if (debt > 0) {
        bob_credit = debt + debt / 4;
        bob_credit_payment = bob_credit / 24;
    }

    RUB penalty = bob_laundry.rent * 2;
    if (p.cash >= penalty) p.cash -= penalty;
    else p.cash = 0;

    char tmp[260];
    snprintf(tmp, sizeof(tmp),
             "ПРОГОРЕЛ: техника продана за %llu₽, долг бизнеса %llu₽, "
             "личный кредит %llu₽ (платёж %llu₽/мес), неустойка %llu₽",
             salvage, bob_laundry.loan, bob_credit, bob_credit_payment, penalty);
    append_comment(comment, tmp);
}

void bob_business_risk(Person& p, char* comment, int year, int month) {
    (void)month;
    if (!bob_laundry.opened || bob_laundry.closed) return;
    if (year < 2027) return;

    if (rand() % 100 < 4) {
        close_bob_business(p, comment);
    }
}

void bob_credit_step(Person& p, char* comment) {
    if (bob_credit == 0) return;

    RUB pay = bob_credit_payment;
    if (pay > bob_credit) pay = bob_credit;
    bob_credit -= pay;

    if (p.cash >= pay) p.cash -= pay;
    else p.cash = 0;

    char tmp[140];
    snprintf(tmp, sizeof(tmp), "кредит: платёж %llu₽, остаток %llu₽",
             pay, bob_credit);
    append_comment(comment, tmp);
}


 
//  ОТКРЫТИЕ И РАБОТА БИЗНЕСА
 

void open_business(Person& p, Business& b, char* comment, int year, int month) {
    if (b.opened) return;
    b.opened = 1;
    b.open_year = year;
    b.open_month = month;

    char tmp[180];
    if (p.cash >= b.open_cost) {
        p.cash -= b.open_cost;
        snprintf(tmp, sizeof(tmp), "открытие %s за %llu₽", b.name, b.open_cost);
    } else {
        RUB need = b.open_cost - p.cash;
        p.cash = 0;
        b.loan = need + need / 5;
        b.loan_payment = b.loan / 24;
        snprintf(tmp, sizeof(tmp),
                 "открытие %s в кредит: заём %llu₽, платёж %llu₽/мес",
                 b.name, b.loan, b.loan_payment);
    }
    append_comment(comment, tmp);
}

void run_business(Person& p, Business& b, char* comment, int year, int month) {
    (void)year; (void)month;
    if (!b.opened) return;

    long long income = 0;
    long long cost = (long long)b.rent + b.komunicazii + b.workers + b.rashodniki;
    char tmp[220];

    if (&b == &bob_laundry) {
        int visitors = 250 + rand() % 700;
        income = (long long)visitors * 100;
        b.last_visitors = visitors;
        snprintf(tmp, sizeof(tmp),
                 "прачечная: пришло %d чел. по 100₽, выручка %lld₽",
                 visitors, income);
    } else if (&b == &bob_wb) {
        int orders = 3000 + rand() % 4000;
        long long turnover = (long long)orders * 1200;
        income = turnover * 35 / 1000;
        b.last_visitors = orders;
        snprintf(tmp, sizeof(tmp),
                 "ПВЗ WB: выдано %d заказов, оборот %lld₽, доход %lld₽ (3,5%%)",
                 orders, turnover, income);
    } else {
        int shelves = 80 + rand() % 60;
        long long shelf_income = (long long)shelves * 150 * 4;
        long long sales = 40000 + rand() % 80000;
        long long commission = sales * 23 / 100;
        income = shelf_income + commission;
        b.last_visitors = shelves;
        snprintf(tmp, sizeof(tmp),
                 "лавка: %d арендаторов, выручка %lld₽ (полки + комиссия 23%%)",
                 shelves, income);
    }
    append_comment(comment, tmp);

    if (b.loan > 0) {
        long long pay = (long long)b.loan_payment;
        if ((RUB)pay > b.loan) pay = (long long)b.loan;
        b.loan -= (RUB)pay;
        cost += pay;
    }

    long long net = income - cost;
    b.last_net = net;
    b.total_net += net;

    if (net >= 0) p.cash += (RUB)net;
    else p.cash -= (RUB)(-net);

    if (net >= 0) snprintf(tmp, sizeof(tmp), "прибыль бизнеса +%lld₽", net);
    else          snprintf(tmp, sizeof(tmp), "убыток бизнеса %lld₽", net);
    append_comment(comment, tmp);
}


 
