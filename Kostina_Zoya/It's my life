//  ИПОТЕКА
 

RUB calc_payment(RUB principal, double monthly_rate, int months) {
    double p = (double)principal;
    double r = monthly_rate;
    double pw = 1.0;
    for (int i = 0; i < months; ++i) pw *= (1.0 + r);
    double pay = p * r * pw / (pw - 1.0);
    return (RUB)(pay + 0.5);
}

int calc_months_left(RUB principal, double monthly_rate, RUB payment) {
    if (principal == 0) return 0;
    int n = 0;
    RUB bal = principal;
    while (bal > 0 && n < 1200) {
        RUB interest = (RUB)((double)bal * monthly_rate);
        if (payment <= interest) return 1200;
        RUB to_principal = payment - interest;
        if (to_principal >= bal) { n++; break; }
        bal -= to_principal;
        n++;
    }
    return n;
}

void mortgage_init(Mortgage& m, RUB principal, double annual_rate,
                   int months, RUB extra_payment) {
    m.principal = principal;
    m.annual_rate = annual_rate;
    m.monthly_rate = annual_rate / 12.0;
    m.initial_months = months;
    m.months_left = months;
    m.payment = calc_payment(principal, m.monthly_rate, months);
    m.extra_payment = extra_payment;
    m.total_interest = 0;
    m.total_paid = 0;
    m.started = 1;
}

void mortgage_step(Person& p, Mortgage& m, char* comment, int year, int month) {
    if (!m.started || m.principal == 0) return;

    // 1. Проценты за месяц
    RUB interest = (RUB)((double)m.principal * m.monthly_rate);

    // 2. Обязательный платёж
    RUB pay = m.payment;
    if (pay > m.principal + interest) pay = m.principal + interest;

    // --- обязательный платёж ---
    if (p.cash >= pay) {
        p.cash -= pay;
        m.total_paid += pay;

        RUB avail = pay;

        // Сначала гасим накопленную просрочку
        RUB kill = (avail < m.overdue_interest) ? avail : m.overdue_interest;
        m.overdue_interest -= kill; avail -= kill;
        kill = (avail < m.overdue_principal) ? avail : m.overdue_principal;
        m.overdue_principal -= kill; avail -= kill;

        // Потом — текущие проценты
        RUB to_int = (avail < interest) ? avail : interest;
        m.total_interest += to_int; avail -= to_int;

        // И тело долга
        RUB to_principal = (avail < m.principal) ? avail : m.principal;
        m.principal -= to_principal;

        if (m.overdue_principal == 0 && m.overdue_interest == 0
            && m.penalty_accumulated == 0)
            m.months_since_overdue = 0;
    } else {
        // --- просрочка ---
        RUB shit = pay - p.cash;
        p.cash = 0;

        RUB overdue_base = shit + m.overdue_principal + m.overdue_interest;
        RUB penalty = overdue_base * 3 / 100;
        m.penalty_accumulated += penalty;

        RUB fine = (m.overdue_count_12m == 0) ? 1000 : 3000;

        RUB overdue_int = (RUB)((double)m.principal * m.monthly_rate);
        RUB overdue_prin = (shit > overdue_int) ? (shit - overdue_int) : 0;

        m.overdue_interest  += overdue_int + penalty + fine;
        m.overdue_principal += overdue_prin;

        m.overdue_count_12m++;
        m.months_since_overdue++;
        m.bkirecord = 1;

        if (m.overdue_count_12m >= 6 && !m.acceleration_demand) {
            m.acceleration_demand = 1;
            RUB full = m.principal + m.overdue_principal
                     + m.overdue_interest + m.penalty_accumulated;
            m.principal = full;
            m.overdue_principal = 0;
            m.overdue_interest = 0;
            m.penalty_accumulated = 0;
            append_comment(comment, "БАНК ТРЕБУЕТ ВСЮ СУММУ ДОСРОЧНО!");
        }

        char tmp[220];
        snprintf(tmp, sizeof(tmp),
                 "просрочка! долг %llu₽, пеня %llu₽, штраф %llu₽, "
                 "просрочек за год: %d",
                 m.overdue_principal + m.overdue_interest,
                 m.penalty_accumulated, fine, m.overdue_count_12m);
        append_comment(comment, tmp);
    }

    // --- досрочный платёж ---
    RUB extra = 0;
    if (m.extra_payment > 0 && m.principal > 0) {
        extra = m.extra_payment;
        if (extra > m.principal) extra = m.principal;

        if (p.cash >= extra) {
            p.cash -= extra;
            m.principal -= extra;
            m.total_paid += extra;
        } else {
            RUB shit_extra = extra - p.cash;
            p.cash = 0;
            RUB pen = shit_extra * 3 / 100;
            m.penalty_accumulated += pen;
            append_comment(comment, "просрочка досрочного платежа");
        }
    }

    // Пересчёт срока
    m.months_left = calc_months_left(m.principal, m.monthly_rate, m.payment);

    // Комментарий
    char tmp[220];
    if (m.principal == 0) {
        snprintf(tmp, sizeof(tmp),
                 "ипотека закрыта! всего уплачено %llu₽, процентов %llu₽",
                 m.total_paid, m.total_interest);
        append_comment(comment, tmp);
    } else {
        snprintf(tmp, sizeof(tmp),
                 "ипотека: платёж %llu₽%s, осталось %d лет (%llu₽), проценты %llu₽",
                 pay, extra ? " + досрочно" : "",
                 (m.months_left + 11) / 12,
                 m.principal, m.total_interest);
        append_comment(comment, tmp);
    }
}

// --- реструктуризация (вне simulation!) ---
void try_restructuring(Person& p, Mortgage& m, char* comment) {
    (void)p;
    if (m.overdue_count_12m < 2) return;
    if (m.restructuring_asked) return;

    m.restructuring_asked = 1;
    m.payment = m.payment * 80 / 100;
    m.initial_months += 24;
    m.months_left += 24;

    m.principal += m.overdue_principal + m.overdue_interest;
    m.overdue_principal = 0;
    m.overdue_interest = 0;
    m.penalty_accumulated = 0;
    m.months_since_overdue = 0;

    append_comment(comment,
        "реструктуризация: платёж снижен на 20%, срок +24 мес");
}


 
