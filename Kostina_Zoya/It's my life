class TaxSystem {
public:
    RUB annual_income        = 0;
    RUB annual_ndfl_paid     = 0;
    RUB total_ndfl_paid      = 0;

    int    usn_mode          = 0;
    double usn_rate          = 0.06;
    RUB    annual_revenue    = 0;
    RUB    annual_usn_paid   = 0;
    RUB    total_usn_paid    = 0;

    RUB    pension_fixed         = 49500;
    double pension_extra_rate    = 0.01;
    RUB    pension_extra_max     = 300000;
    RUB    annual_insurance_paid = 0;
    RUB    total_insurance_paid  = 0;

    double property_rate      = 0.001;
    RUB    property_cadastral = 0;
    RUB    property_deduction = 0;
    RUB    annual_property_paid = 0;
    RUB    total_property_paid  = 0;

    int    horsepower         = 0;
    double transport_rate     = 0.0;
    RUB    annual_transport_paid = 0;
    RUB    total_transport_paid  = 0;

    double land_rate          = 0.003;
    RUB    land_cadastral     = 0;
    RUB    annual_land_paid   = 0;
    RUB    total_land_paid    = 0;

    RUB    total_all_paid      = 0;

    static constexpr RUB NDFL_B1 =  2400000ULL;
    static constexpr RUB NDFL_B2 =  5000000ULL;
    static constexpr RUB NDFL_B3 = 20000000ULL;
    static constexpr RUB NDFL_B4 = 50000000ULL;
    static constexpr RUB USN_LIMIT = 450000000ULL;
    static constexpr RUB PENSION_REVENUE_THRESHOLD = 300000ULL;

    void init(int hp, double tr_rate, RUB cadastral, RUB land_cad) {
        horsepower         = hp;
        transport_rate     = tr_rate;
        property_cadastral = cadastral;
        property_deduction = cadastral / 5;
        land_cadastral     = land_cad;
    }

    static RUB calcNDFL(RUB annual) {
        RUB tax = 0;
        if (annual <= NDFL_B1) return annual * 13 / 100;
        tax += NDFL_B1 * 13 / 100;

        if (annual <= NDFL_B2) return tax + (annual - NDFL_B1) * 15 / 100;
        tax += (NDFL_B2 - NDFL_B1) * 15 / 100;

        if (annual <= NDFL_B3) return tax + (annual - NDFL_B2) * 18 / 100;
        tax += (NDFL_B3 - NDFL_B2) * 18 / 100;

        if (annual <= NDFL_B4) return tax + (annual - NDFL_B3) * 20 / 100;
        tax += (NDFL_B4 - NDFL_B3) * 20 / 100;

        return tax + (annual - NDFL_B4) * 22 / 100;
    }

    void applyNDFL(Person& p, RUB gross, char* comment) {
        annual_income += gross;
        RUB full_year  = calcNDFL(annual_income);
        RUB month_tax  = full_year - annual_ndfl_paid;
        if (month_tax > p.cash) month_tax = p.cash;

        p.cash            -= month_tax;
        annual_ndfl_paid  += month_tax;
        total_ndfl_paid   += month_tax;
        total_all_paid    += month_tax;

        char tmp[160];
        snprintf(tmp, sizeof(tmp),
                 "НДФЛ: −%llu₽ (за год %llu₽)",
                 month_tax, annual_ndfl_paid);
        append_comment(comment, tmp);
    }

    void applyUSN(Person& p, Business& b, char* comment) {
        if (!b.opened || usn_mode == 0) return;

        RUB income = (b.total_net > 0) ? (RUB)b.total_net : 0;
        RUB tax = 0;

        if (usn_mode == 6) {
            tax = (RUB)((double)income * usn_rate);
        } else if (usn_mode == 15) {
            RUB min_tax = income / 100;
            tax = (RUB)((double)income * usn_rate);
            if (tax < min_tax) tax = min_tax;
        }

        if (annual_revenue > USN_LIMIT) tax *= 2;

        if (tax > p.cash) tax = p.cash;
        p.cash           -= tax;
        annual_usn_paid  += tax;
        total_usn_paid   += tax;
        total_all_paid   += tax;

        char tmp[180];
        snprintf(tmp, sizeof(tmp),
                 "УСН (%d%%): −%llu₽ с бизнеса «%s»",
                 usn_mode, tax, b.name);
        append_comment(comment, tmp);
    }

    void applyInsuranceIP(Person& p, char* comment, int year) {
        if (usn_mode == 0) return;

        RUB extra = 0;
        if (annual_revenue > PENSION_REVENUE_THRESHOLD) {
            extra = (RUB)((double)(annual_revenue - PENSION_REVENUE_THRESHOLD)
                          * pension_extra_rate);
            if (extra > pension_extra_max) extra = pension_extra_max;
        }

        RUB total = pension_fixed + extra;
        if (total > p.cash) total = p.cash;
        p.cash                 -= total;
        annual_insurance_paid  += total;
        total_insurance_paid   += total;
        total_all_paid         += total;

        char tmp[180];
        snprintf(tmp, sizeof(tmp),
                 "страх. взносы ИП (%d): −%llu₽ (фикс %llu + 1%% %llu)",
                 year, total, pension_fixed, extra);
        append_comment(comment, tmp);
    }

    RUB calcPropertyTax() const {
        if (property_cadastral <= property_deduction) return 0;
        return (RUB)((double)(property_cadastral - property_deduction)
                     * property_rate);
    }
    RUB calcTransportTax() const {
        return (RUB)((double)horsepower * transport_rate);
    }
    RUB calcLandTax() const {
        return (RUB)((double)land_cadastral * land_rate);
    }

    void applyAssetTaxes(Person& p, char* comment, int year) {
        RUB pt = calcPropertyTax();
        RUB tt = calcTransportTax();
        RUB lt = calcLandTax();

        RUB total = pt + tt + lt;
        if (total > p.cash) total = p.cash;
        p.cash -= total;

        annual_property_paid  += pt;
        total_property_paid   += pt;
        annual_transport_paid += tt;
        total_transport_paid  += tt;
        annual_land_paid      += lt;
        total_land_paid       += lt;
        total_all_paid        += total;

        char tmp[220];
        snprintf(tmp, sizeof(tmp),
                 "имущ. налоги (%d): −%llu₽ (кв. %llu + авто %llu + земля %llu)",
                 year, total, pt, tt, lt);
        append_comment(comment, tmp);
    }

    void resetYear() {
        annual_income         = 0;
        annual_ndfl_paid      = 0;
        annual_revenue        = 0;
        annual_usn_paid       = 0;
        annual_insurance_paid = 0;
        annual_property_paid  = 0;
        annual_transport_paid = 0;
        annual_land_paid      = 0;
    }
};


 
