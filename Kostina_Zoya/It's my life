    { "родился ребёнок",             4, 260000, 0, 2028 },
    { "детский сад, взнос",         10,  27000, 0, 2028 },
};

void roll_events(Person& p, LifeEvent* events, int count, char* comment, int year) {
    for (int i = 0; i < count; ++i) {
        LifeEvent& e = events[i];
        if (e.min_year != 0 && year < e.min_year) continue;
        if (rand() % 100 >= e.chance) continue;

        if (e.is_income) {
            p.cash += e.amount;
        } else {
            if (p.cash >= e.amount) p.cash -= e.amount;
            else p.cash = 0;
        }

        char tmp[160];
        snprintf(tmp, sizeof(tmp), "%s %+lld₽",
                 e.title, e.is_income ? (long long)e.amount : -(long long)e.amount);
        append_comment(comment, tmp);
    }
}


 
//  СИМУЛЯЦИЯ
 

void simulation() {
    int year = 2026;
    int month = 9;
    double food_cost = 25000.0;
    double utility_cost = 7000.0;

    printf("%-12s %4s %14s %14s\n", "Месяц", "Год", "Алиса (руб)", "Боб (руб)");
    printf("--------------------------------------------------------------------\n");

    while (!(year == 2030 && month == 9)) {
        clear_comments();

        food_cost *= 1.005;
        utility_cost *= 1.005;

        // Доходы
        alice_salary(year, month);
        bob_salary(year, month);
        apply_expenses(alice, food_cost, utility_cost);
        apply_expenses(bob, food_cost * 0.92, utility_cost * 0.95);

        // НДФЛ
        alice_taxes.applyNDFL(alice, alice.salary, alice_comment);
        bob_taxes.applyNDFL(bob,     bob.salary,   bob_comment);

        // Ипотека
        mortgage_step(alice, alice_mortgage, alice_comment, year, month);
        mortgage_step(bob,   bob_mortgage,   bob_comment,   year, month);
        try_restructuring(alice, alice_mortgage, alice_comment);
        try_restructuring(bob,   bob_mortgage,   bob_comment);

        // Хобби
        hobby_step(alice, alice_horse, alice_comment);
        hobby_step(bob,   bob_box,     bob_comment);

        // Подработка Алисы
        alice_side_job(alice, alice_comment);

        // Открытие бизнесов
        if (year == 2027 && month == 2) {
            open_business(alice, alice_shop,  alice_comment, year, month);
            open_business(bob,   bob_laundry, bob_comment,   year, month);
        }
        if (year == 2028 && month == 2) {
            open_business(bob, bob_wb, bob_comment, year, month);
        }

        // Работа бизнесов
        run_business(alice, alice_shop,  alice_comment, year, month);
        run_business(bob,   bob_laundry, bob_comment,   year, month);
        run_business(bob,   bob_wb,      bob_comment,   year, month);

        // Учёт выручки в годовых счётчиках для УСН
        if (alice_shop.opened)
            alice_taxes.annual_revenue += (RUB)alice_shop.last_net;
        if (bob_laundry.opened)
            bob_taxes.annual_revenue += (RUB)bob_laundry.last_net;
        if (bob_wb.opened)
            bob_taxes.annual_revenue += (RUB)bob_wb.last_net;

        // Риск и кредит Боба
        bob_business_risk(bob, bob_comment, year, month);
        bob_credit_step(bob, bob_comment);

        // Покупки
        purchases_step(alice, alice_horse_buys,
                       sizeof(alice_horse_buys) / sizeof(Purchase),
                       alice_comment, year, month);
        purchases_step(bob, bob_box_buys,
                       sizeof(bob_box_buys) / sizeof(Purchase),
                       bob_comment, year, month);
        purchases_step(alice, alice_furniture,
                       sizeof(alice_furniture) / sizeof(Purchase),
                       alice_comment, year, month);
        purchases_step(bob, bob_furniture,
                       sizeof(bob_furniture) / sizeof(Purchase),
                       bob_comment, year, month);

        // Случайные события
        roll_events(alice, alice_events,
                    sizeof(alice_events) / sizeof(LifeEvent), alice_comment, year);
        roll_events(bob, bob_events,
                    sizeof(bob_events) / sizeof(LifeEvent), bob_comment, year);

        // Строка месяца
        printf("%-12s %4d %14llu %14llu\n",
               get_month_name(month), year, alice.cash, bob.cash);

        if (alice_comment[0]) printf("   Алиса: %s\n", alice_comment);
        if (bob_comment[0])   printf("   Боб:   %s\n", bob_comment);

        printf("--------------------------------------------------------------------\n");

        // Годовые налоги — в декабре
        if (month == 12) {
            alice_taxes.applyUSN(alice, alice_shop, alice_comment);
            bob_taxes.applyUSN(bob, bob_laundry, bob_comment);
            bob_taxes.applyUSN(bob, bob_wb,      bob_comment);

            alice_taxes.applyInsuranceIP(alice, alice_comment, year);
            bob_taxes.applyInsuranceIP(bob,   bob_comment,   year);

            alice_taxes.applyAssetTaxes(alice, alice_comment, year);
            bob_taxes.applyAssetTaxes(bob,   bob_comment,   year);

            if (!alice_mortgage.acceleration_demand)
                alice_mortgage.overdue_count_12m = 0;
            if (!bob_mortgage.acceleration_demand)
                bob_mortgage.overdue_count_12m = 0;
        }

        // Сброс годовых счётчиков — в январе
        if (month == 1) {
            alice_taxes.resetYear();
            bob_taxes.resetYear();
        }

        ++month;
        if (month == 13) { ++year; month = 1; }
    }

    // --- ИТОГИ ---
    printf("====================================================================\n");
    printf("%-26s %14llu %14llu\n", "ИТОГО:", alice.cash, bob.cash);
    printf("\nБизнес Алисы (накопленный итог): %lld₽\n", alice_shop.total_net);
    printf("Бизнес Боба (накопленный итог):  %lld₽\n", bob_laundry.total_net);

    printf("\nИпотека Алисы: %s, проценты %llu₽, внесено %llu₽\n",
           alice_mortgage.principal == 0 ? "закрыта" : "активна",
           alice_mortgage.total_interest, alice_mortgage.total_paid);
    printf("Ипотека Боба:  %s, проценты %llu₽, внесено %llu₽\n",
           bob_mortgage.principal == 0 ? "закрыта" : "активна",
           bob_mortgage.total_interest, bob_mortgage.total_paid);

    printf("\nХобби Алисы (конный спорт): потрачено %llu₽\n", alice_horse.total_spent);
    printf("Хобби Боба (бокс):          потрачено %llu₽\n", bob_box.total_spent);

    printf("Второй этаж магазина Алисы: %s\n",
           alice_mop.second_floor_open ? "открыт" : "не открыт");

    if (bob_laundry.closed)
        printf("Бизнес Боба: закрыт (прогорел), остаток личного кредита %llu₽\n",
               bob_credit);
    else
        printf("Бизнес Боба: работает\n");

    printf("ПВЗ Wildberries Боба: %s, накопленный итог %lld₽\n",
           bob_wb.opened ? "работает" : (bob_wb.closed ? "закрыт" : "не открыт"),
           bob_wb.total_net);

    printf("\nНалоги Алисы: всего %llu₽ "
           "(НДФЛ %llu, УСН %llu, взносы %llu, имущ./трансп./земля %llu)\n",
           alice_taxes.total_all_paid,
           alice_taxes.total_ndfl_paid,
           alice_taxes.total_usn_paid,
           alice_taxes.total_insurance_paid,
           alice_taxes.total_property_paid
             + alice_taxes.total_transport_paid
             + alice_taxes.total_land_paid);

    printf("Налоги Боба:  всего %llu₽ "
           "(НДФЛ %llu, УСН %llu, взносы %llu, имущ./трансп./земля %llu)\n",
           bob_taxes.total_all_paid,
           bob_taxes.total_ndfl_paid,
           bob_taxes.total_usn_paid,
           bob_taxes.total_insurance_paid,
           bob_taxes.total_property_paid
             + bob_taxes.total_transport_paid
             + bob_taxes.total_land_paid);
}


