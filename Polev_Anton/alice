bool job_interview(const Person& person)//собеседование
{
    int chance = 50;

    chance += person.education / 5;

    if (person.work_experience > 0)
    {
        chance += 10;
    }

    int result = rand() % 100;

    return result < chance;
}


void find_job(Person& person)//есть ли работа
{
    if (person.has_job)
    {
        return;
    }

    if (job_interview(person))
    {
        person.has_job = true;
        person.salary = 80'000;
    }
}


void salary(const int year, const int month)//зарплата
{
    find_job(alice);
    find_job(bob);

    if (alice.has_job and not family.alice_maternity)
