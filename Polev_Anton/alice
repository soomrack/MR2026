void housing()//жилье
{
    if (family.mortgage_started)
    {
        pay_mortgage();
        return;
    }


    if (family.married)
    {
        alice.cash -= family.rent_payment / 2;
        bob.cash -= family.rent_payment / 2;

        start_mortgage();
        return;
    }


    alice.cash -= alice.rent_payment;
    bob.cash -= bob.rent_payment;


    family.apartment_price +=
        family.apartment_price * 3 / 1000;
}

