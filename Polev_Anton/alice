random_event choose_random_event()//случайные события
{
    int result = rand() % 100;

    if (result < 3)
        return bonus;

    if (result < 6)
        return equipment_breakdown;

    if (result < 10)
        return unexpected_expense;

    if (result < 12)
        return salary_raise;

    if (result < 13)
        return job_loss;

    if (result < 16)
        return health_improvement;

    if (result < 20)
        return health_problem;

    return no_event;
}

void deposit_for_person(Person& person)//накопление
{
    RUB deposit_amount = person.salary / 10;

    if (deposit_amount > person.cash)
    {
        deposit_amount = person.cash;
    }

    person.cash -= deposit_amount;
    person.savings += deposit_amount;

    if (person.strategy == fixed_deposit)
    {
        // Фиксированный доход 1% в месяц
        RUB income = person.savings / 100;
        person.savings += income;
    }

    if (person.strategy == stocks)
    {
        // Доход от акций от -1% до +2%
        int stock_change = rand() % 4 - 1;

        RUB income = person.savings * stock_change / 100;
        person.savings += income;

        if (person.savings < 0)
        {
            person.savings = 0;
        }
    }
}


void deposit()//вклад или акции
{
    deposit_for_person(alice);
    deposit_for_person(bob);
}

RUB calculate_mortgage_payment(const RUB loan)//плата по ипотеке
{
    const double annual_interest = 0.10;
    const double monthly_interest = annual_interest / 12;
    const int mortgage_months = 240;

    double payment = loan * monthly_interest /
        (1 - pow(1 + monthly_interest, -mortgage_months));

    return (RUB)payment;
}

food_type choose_food()//шансы качества еды
{
    int result = rand() % 100;

    if (result < 15)
    {
        return healthy_food;
    }

    if (result < 35)
    {
        return unhealthy_food;
    }

    if (result < 70)
    {
        return neutral_food;
    }

    if (result < 90)
    {
        return good_food;
    }

    return very_good_food;
}

void start_mortgage()//начало ипотеки
{
    const RUB down_payment = family.apartment_price * 30 / 100;
    const RUB mortgage_amount = family.apartment_price - down_payment;

    RUB total_money = alice.cash + alice.savings +
                      bob.cash + bob.savings;

    if (total_money < down_payment)
    {
        return;
    }

    RUB remaining_down_payment = down_payment;

    RUB alice_cash_payment = alice.cash;

    if (alice_cash_payment > remaining_down_payment)
    {
        alice_cash_payment = remaining_down_payment;
    }

    alice.cash -= alice_cash_payment;
    remaining_down_payment -= alice_cash_payment;


    RUB alice_savings_payment = alice.savings;

    if (alice_savings_payment > remaining_down_payment)
    {
        alice_savings_payment = remaining_down_payment;
    }

    alice.savings -= alice_savings_payment;
    remaining_down_payment -= alice_savings_payment;


    RUB bob_cash_payment = bob.cash;

    if (bob_cash_payment > remaining_down_payment)
    {
        bob_cash_payment = remaining_down_payment;
    }

    bob.cash -= bob_cash_payment;
    remaining_down_payment -= bob_cash_payment;


    if (remaining_down_payment > 0)
    {
        RUB bob_savings_payment = bob.savings;

        if (bob_savings_payment > remaining_down_payment)
        {
            bob_savings_payment = remaining_down_payment;
        }

        bob.savings -= bob_savings_payment;
        remaining_down_payment -= bob_savings_payment;
    }


    family.mortgage_balance = mortgage_amount;
    family.mortgage_payment =
        calculate_mortgage_payment(mortgage_amount);

    family.mortgage_started = true;
}

void pay_mortgage()//платеж по ипотеке
{
    if (not family.mortgage_started or family.mortgage_paid)
    {
        return;
    }

    const double annual_interest = 0.10;
    const double monthly_interest = annual_interest / 12;

    RUB interest =
        family.mortgage_balance * monthly_interest;

    RUB principal =
        family.mortgage_payment - interest;

    RUB alice_payment =
        family.mortgage_payment / 2;

    RUB bob_payment =
        family.mortgage_payment - alice_payment;

    if (alice.cash >= alice_payment)
    {
        alice.cash -= alice_payment;
    }
    else
    {
        RUB remaining = alice_payment - alice.cash;
        alice.cash = 0;

        if (alice.savings >= remaining)
        {
            alice.savings -= remaining;
        }
        else
        {
            alice.savings = 0;
        }
    }

    if (bob.cash >= bob_payment)
    {
        bob.cash -= bob_payment;
    }
    else
    {
        RUB remaining = bob_payment - bob.cash;
        bob.cash = 0;

        if (bob.savings >= remaining)
        {
            bob.savings -= remaining;
        }
        else
        {
            bob.savings = 0;
        }
    }

    if (principal >= family.mortgage_balance)
    {
        family.mortgage_balance = 0;
        family.mortgage_paid = true;
        return;
    }

    family.mortgage_balance -= principal;
}

