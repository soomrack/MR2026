void dating()//свидания
{
    if (family.married)
    {
        return;
    }

    int chance = 30;

    chance += (alice.health + bob.health) / 10;
    chance += (alice.education + bob.education) / 20;

    if (rand() % 100 < chance)
    {
        const RUB date_cost = 5'000;

        if (alice.cash >= date_cost / 2 &&
            bob.cash >= date_cost / 2)
        {
            alice.cash -= date_cost / 2;
            bob.cash -= date_cost / 2;

            ++family.relationship;
        }
    }

    if (family.relationship > 100)
    {
        family.relationship = 100;
    }
}


