void alice_get_bank() // вклад
{
    if (!alice.deposit_done and alice.cash - 100000.0 >= 50000.0) {
        alice.deposit = 100000.0;
        alice.cash -= 100000.0;

        alice.deposit_done = true;
    }

    if (alice.deposit_done and alice_bank.bank_calss < alice_bank.bank_month) {
        ++alice_bank.bank_calss;
        alice.deposit  *= 1.1;
    }
    if (alice_bank.bank_calss == alice_bank.bank_month) {
        alice.cash += alice.deposit;
        alice.deposit = 0.0;
    }
}

void bob_get_bank() // вклад
{
    if (!bob.deposit_done and bob.cash - 150000.0 >= 50000.0) {
        bob.deposit = 150000.0;
        bob.cash -= 150000.0;

        bob.deposit_done = true;
    }

    if (bob.deposit_done and bob_bank.bank_calss < bob_bank.bank_month) {
        ++bob_bank.bank_calss;
        bob.deposit *= 1.1;
    }
    if (bob_bank.bank_calss == bob_bank.bank_month) {
        bob.cash += bob.deposit;
        bob.deposit = 0.0;
    }
}

void alice_sick(int& alice_already_sick)
{
    double sick_chance;  

    sick_chance = distrib(gen);

    if (sick_chance < 0.4 and alice_already_sick > 3) {
        alice.cash -= 5000.0;
        alice_already_sick = 0;
    }
    else {
        alice_already_sick++;
    }
}

void bob_sick(int& bob_already_sick)
{
    double sick_chance;

    sick_chance = distrib(gen);

    if (sick_chance < 0.4 and bob_already_sick > 3) {
        bob.cash -= 5000.0;
        bob_already_sick = 0;
    }
    else {
        bob_already_sick++;

    }
}

