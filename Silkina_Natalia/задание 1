void alice_poverty()
{
    if (alice.cash <= 0 ) {
        if (alice.bank_bill > 40000.0) {
            alice.cash += alice.bank_bill * 0.5;
            alice.bank_bill *= 0.5;
        }
        else {
            alice.cash += alice.bank_bill;
            alice.bank_bill = 0;
        }

     }
    else if (alice.cash <= 0 and alice.bank_bill == 0) {
        alice.cash = alice.deposit;
        alice.deposit = 0;
    }
    else {
        return;
    }
}   

