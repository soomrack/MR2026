#include <stdio.h>
#include <random>

std::random_device rd;
std::mt19937 gen(rd());
std::uniform_int_distribution<> distrib(0.0, 1.0);

//typedef double RUB;
using RUB = double;


struct Person {
    RUB cash;
    RUB salary;
    RUB deposit;
};

struct Person alice;
struct Person bob;

void bob_salary(const int year, const int month)
{
    if (month == 1) {
        bob.salary *= 1.10;
    }

    bob.cash += bob.salary;
}

void alice_salary(const int year, const int month)
{
    if(month == 1) {  // Promotion
        alice.salary *= 1.10;
    }
        
    alice.cash += alice.salary;
}

void alice_food(const int month)
{
    RUB food = 15000;

    if (month == 1) {
        food *= 1.04;
    }

    alice.cash -= food;
}

void alice_rent(const int month)
{
    RUB rent = 25000.0;

    if (month == 1) {
        rent *= 1.04;
    }

    if (month >= 4 and month <= 9) {
        alice.cash -= rent*0.98;
    }
    else {
        alice.cash -= rent;
    }
    
}

void alice_car(const int year, bool& alice_have_car)
{
    if (alice.cash > 500000.0 && !alice_have_car) {
        alice.cash -= 500000.0;
        alice_have_car = true;
    }
    else {
        return;
    }
    if (alice_have_car) {
        alice.cash -= 15000.0;
    }
}

void bank(bool& deposit_done, const int bank_month, int& bank_calls) {

    if (!deposit_done and alice.cash - 100000.0 >= 50000.0) {
        alice.deposit = 100000.0;
        alice.cash -= 100000.0;

        deposit_done = true;
    }

    if (deposit_done and (bank_calls < bank_month)) {
        ++bank_calls;
        alice.deposit  *= 1.1;
        //printf("Alice deposit = %f\n", alice.deposit);
    }
    if (bank_calls == bank_month) {
        alice.cash += alice.deposit;
        alice.deposit = 0.0;
    }
}

void alice_sick(int& already_sick)
{
    double sick_chance;  

    sick_chance = distrib(gen);

    if (sick_chance < 0.4 and already_sick > 3) {
        alice.cash -= 5000.0;
       // printf("%d\n", 1);
        already_sick = 0;
    }
    else {
        already_sick++;
       // printf("%d\n", 0);

    }
}

void simulation()
{
    int year = 2026;
    int month = 9;

    bool deposit_done = false;
    int bank_calls = 0;
    int bank_month = 12;

    bool alice_have_car = false;

    int already_sick = 0;

    while (not (year == 2035 and month == 9)) {

        alice_salary(year, month);
        alice_food(month);
        alice_rent(month);
        alice_sick(already_sick);
        alice_car(year, alice_have_car);
        // alice_mortgage();
        // alice_rent();
        // alice_home_bills();
        // alice_food();
        // alice_dog();
        // alice_bank_income();

        bob_salary(year, month);
        bank(deposit_done, bank_month, bank_calls);
        
        ++month;
      //  printf("%d\n", month);
        // printf("%d\n", alice_have_car);
        if (month == 13) {
            ++year;
            month = 1;
            //printf("%d\n", year);
            //printf("%d\n", month);
        }
    }
}


void alice_init()
{
    alice.cash = 20000.0;
    alice.salary = 40000.0;
    alice.deposit = 0.0;
}


void alice_print()
{
    printf("Alice salary = %f\n", alice.salary);
    printf("Alice cash = %f\n", alice.cash);
    printf("Alice deposit = %f\n", alice.deposit);
}

void bob_init()
{
    bob.cash = 30000;
    bob.salary = 60000;
    bob.deposit = 100000;
}

void bob_print()
{
    printf("Bob salary = %f\n", bob.salary);
    printf("Bob cash = %f\n", bob.cash);
    printf("Bob deposit = %f\n", bob.deposit);
}

int main()
{
    alice_init();

    bob_init();
    
    simulation();

    alice_print();

   // bob_print();
}
