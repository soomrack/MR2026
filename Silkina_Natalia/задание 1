void simulation()
{
    int year = 2026;
    int month = 9;

    bool alice_have_car = false;

    bool new_computer = false;

    int alice_already_sick = 0;
    int bob_already_sick = 0;

    while (not (year == 2036 and month == 9) and alice.live) {

        alice_salary(year, month);
        alice_food(month);
        alice_rent(month);
        alice_sick(alice_already_sick);
        alice_car(year, alice_have_car);
        alice_home_bills(month);
        alice_accidental_spending_of_money();
        alice_cat(year);
        alice_nails(month);
        alice_haire(month);
        alice_get_computer(year, new_computer);
        alice_poverty();
        alice_casino();
        alice_second_job();
        alice_bank_bill();

        bob_salary(year, month);
        bob_accidental_spending_of_money();
        bob_dog();
        bob_food(month);
        bob_home_bills(month);
        bob_rent(month);
        bob_sick(bob_already_sick);
        bob_poverty();
        bob_bank_bill();

        alice_get_bank();
        
        ++month;
        if (month == 13) {
            ++year;
            month = 1;
        }
    }
}


