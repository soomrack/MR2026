void simulation() {
    int year = 2027;
    int month = 1;

    printf("Nachalo simuliacii dlya Alice\n");
    printf("------------------------------------------------------------\n");

    stats_reset_for_year(year);

    while (!(year == 2047 && month == 1)) {
        alice_process_time_events(year, month);
        alice_career_growth(year, month);
        alice_pvz_logic(year, month);
        alice_second_job_logic(year, month);
        alice_sell_car(year, month);
        alice_buy_apartment(year, month);

        alice_process_income(month);
        alice_bank_income();
        alice_tax_refund(month);

        alice_healthy_food();
        alice_rent();
        alice_car_buy();
        alice_pet();
        alice_medical_expenses();
        alice_process_expenses();

        alice_random_events(month);

        if (month == 1 || month == 4 || month == 7 || month == 10) {
            RUB total_exp = alice.expenses.food + alice.expenses.healthy_food +
                alice.expenses.junk_food + alice.expenses.utilities +
                alice.expenses.transport + alice.expenses.entertainment +
                alice.expenses.gifts_fund + alice.expenses.rent +
                alice.car.payment + alice.car.fuel + alice.car.insurance +
                alice.car.maintenance + alice.car.tax +
                alice.pet.food_cost + alice.pet.vet_cost;
            alice_print_month(year, month, total_exp);
        }

        if (alice.cash > 100000) {
            RUB to_save = alice.cash - 100000;
            alice.cash -= to_save;
            alice.savings_account += to_save;
        }

        alice.months_worked++;
        ++month;

        if (month == 13) {
            alice_print_yearly_summary();
            apply_yearly_inflation();
            ++year;
            month = 1;
            stats_reset_for_year(year);
        }
    }
    printf("------------------------------------------------------------\n");
}

