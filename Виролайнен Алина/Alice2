#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <windows.h>
#include <locale.h>

using RUB = unsigned long long int;


struct Car {
    bool has_car;
    int months_owned;
    RUB payment;
    RUB fuel;
    RUB insurance;
    RUB maintenance;
    RUB tax;
};

struct Pet {
    bool is_alive;
    int age_months;
    int max_age_months;
    RUB food_cost;
    RUB vet_cost;
};

struct PVZ {
    bool is_open;
    int months_since_opening;
    RUB rent;
    RUB monthly_income;
    RUB employee_salary;
    bool has_employee;
    RUB total_fines;
    int fines_count;
};

struct Mortgage {
    bool has_mortgage;
    int months_paid;
    RUB monthly_payment;
    RUB property_value;
    RUB down_payment;
    int total_months;
};

struct Expenses {
    RUB food;
    RUB healthy_food;
    RUB junk_food;
    RUB utilities;
    RUB transport;
    RUB entertainment;
    RUB gifts_fund;
    RUB rent;
};

struct Person {
    RUB cash;
    RUB salary;
    RUB parental_support;
    RUB savings_account;
    double savings_rate;

    Expenses expenses;
    Car car;
    Pet pet;
    PVZ pvz;
    Mortgage mortgage;

    bool has_second_job;
    RUB second_job_salary;
    int months_at_second_job;

    bool is_employed;
    int months_worked;
    int health_points;
    int months_since_last_checkup;
};


struct YearlyStats {
    RUB total_income;
    RUB total_expenses;
    int year;
};

struct Person alice;
struct YearlyStats stats;


void alice_init() {
    alice.cash = 500000;
    alice.salary = 0;
    alice.parental_support = 20000;
    alice.savings_account = 400000;
    alice.savings_rate = 0.15;
    alice.is_employed = false;
    alice.months_worked = 0;
    alice.health_points = 90;
    alice.months_since_last_checkup = 0;

    alice.car.has_car = false;
    alice.car.months_owned = 0;
    alice.car.payment = 0;
    alice.car.fuel = 0;
    alice.car.insurance = 0;
    alice.car.maintenance = 0;
    alice.car.tax = 0;

    alice.pet.is_alive = false;
    alice.pet.age_months = 0;
    alice.pet.max_age_months = 12 * 12;
    alice.pet.food_cost = 0;
    alice.pet.vet_cost = 0;

    alice.pvz.is_open = false;
    alice.pvz.months_since_opening = 0;
    alice.pvz.rent = 0;
    alice.pvz.monthly_income = 0;
    alice.pvz.employee_salary = 0;
    alice.pvz.has_employee = false;
    alice.pvz.total_fines = 0;
    alice.pvz.fines_count = 0;

    alice.has_second_job = false;
    alice.second_job_salary = 0;
    alice.months_at_second_job = 0;

    alice.mortgage.has_mortgage = false;
    alice.mortgage.months_paid = 0;
    alice.mortgage.monthly_payment = 0;
    alice.mortgage.property_value = 0;
    alice.mortgage.down_payment = 0;
    alice.mortgage.total_months = 240;

    alice.expenses.food = 10000;
    alice.expenses.healthy_food = 2500;
    alice.expenses.junk_food = 800;
    alice.expenses.utilities = 4000;
    alice.expenses.transport = 2860;
    alice.expenses.entertainment = 3000;
    alice.expenses.gifts_fund = 2000;
    alice.expenses.rent = 25000;

    stats.total_income = 0;
    stats.total_expenses = 0;
    stats.year = 2027;
}

void stats_reset_for_year(int year) {
    stats.total_income = 0;
    stats.total_expenses = 0;
    stats.year = year;
}


void apply_yearly_inflation() {
    alice.expenses.food *= 1.05;
    alice.expenses.healthy_food *= 1.07;
    alice.expenses.junk_food *= 1.04;
    alice.expenses.utilities *= 1.08;
    alice.expenses.transport *= 1.04;
    alice.expenses.entertainment *= 1.05;
    alice.expenses.gifts_fund *= 1.04;
    alice.expenses.rent *= 1.06;
    alice.car.fuel *= 1.05;
    alice.car.insurance *= 1.03;
    alice.car.maintenance *= 1.06;
    alice.pet.food_cost *= 1.05;
    alice.pet.vet_cost *= 1.07;
}

void alice_process_income(int month) {
    if (alice.months_worked < 3) {
        alice.cash += alice.parental_support;
        stats.total_income += alice.parental_support;
    }
    else {
        alice.parental_support = 0;
    }

    if (alice.is_employed) {
        alice.cash += alice.salary;
        stats.total_income += alice.salary;

        if (alice.months_worked > 0 && alice.months_worked % 2 == 0) {
            alice.cash += 20000;
            stats.total_income += 20000;
        }
    }

    if (alice.pvz.is_open) {
        alice.cash += alice.pvz.monthly_income;
        stats.total_income += alice.pvz.monthly_income;
    }
    if (alice.has_second_job) {
        alice.cash += alice.second_job_salary;
        stats.total_income += alice.second_job_salary;
    }
}

void alice_bank_income() {
    RUB monthly_interest = (RUB)(alice.savings_account * alice.savings_rate / 12);
    alice.savings_account += monthly_interest;
}


void alice_tax_refund(int month) {
    if (month == 3) {

        RUB total_annual_income = 0;

        if (alice.is_employed) {
            total_annual_income += alice.salary * 12;
        }

        if (alice.has_second_job) {
            total_annual_income += alice.second_job_salary * 12;
        }

        if (alice.pvz.is_open) {
            total_annual_income += alice.pvz.monthly_income * 12;
        }


        RUB refund = (RUB)(total_annual_income * 0.13);
        alice.cash += refund;

        printf("  [NALOG] Vozvrat NDFL: +%llu rub. (ot obshchego dohoda %llu)\n",
            refund, total_annual_income);
    }
}

void alice_process_expenses() {

    RUB total_expenses = alice.expenses.food + alice.expenses.healthy_food +
        alice.expenses.junk_food + alice.expenses.utilities +
        alice.expenses.transport + alice.expenses.entertainment +
        alice.expenses.gifts_fund + alice.expenses.rent +
        alice.car.payment + alice.car.fuel + alice.car.insurance +
        alice.car.maintenance + alice.car.tax +
        alice.pet.food_cost + alice.pet.vet_cost;

    if (alice.pvz.is_open) {
        total_expenses += alice.pvz.rent;
        if (alice.pvz.has_employee) {
            total_expenses += alice.pvz.employee_salary;
        }
    }

    if (alice.mortgage.has_mortgage) {
        total_expenses += alice.mortgage.monthly_payment;
    }

    if (alice.cash < total_expenses) {
        printf(" Alice v minuse! Balans: %llu\n", alice.cash);
        RUB deficit = total_expenses - alice.cash;
        if (alice.savings_account >= deficit) {
            alice.savings_account -= deficit;
            alice.cash = 0;
            printf(" Pokryli minus so sberezheniy: -%llu rub.\n", deficit);
        }
        else {
            alice.cash = 0;
            alice.savings_account = 0;
            printf("  Deneg net:(( Nado chto-to meniat v svoye zhizni!\n");
        }
    }
    else {
        alice.cash -= total_expenses;
    }

    stats.total_expenses += total_expenses;
}

void alice_rent() {

    if (alice.expenses.rent == 0) return;

    if (alice.months_worked > 0 && alice.months_worked % 24 == 0) {
        alice.expenses.rent = (RUB)(alice.expenses.rent * 1.05);
        printf("  Arendodatel podnyal cenu na 5%%. Novaya arenda: %llu rub.\n", alice.expenses.rent);
    }
}

void alice_car_buy() {
    if (alice.months_worked == 40 && !alice.car.has_car) {
        alice.car.has_car = true;
        alice.car.months_owned = 0;
        alice.car.payment = 15000;
        alice.car.fuel = 5000;
        alice.car.insurance = 3500;
        alice.car.maintenance = 1500;
        alice.car.tax = 250;
        printf("Alice kupila mashinu v kredit!\n");
        printf("Ezhemesyachniy platezh: %llu, Benzin: %llu, Strahovka: %llu\n",
            alice.car.payment, alice.car.fuel, alice.car.insurance);
    }

    if (alice.car.has_car) {
        alice.car.months_owned++;
        if (alice.car.months_owned >= 60) {
            alice.car.payment = 0;
            printf("Avtokredit vyplachen!\n");
        }
        if (alice.car.months_owned > 0 && alice.car.months_owned % 12 == 0) {
            alice.cash -= 12000;
            printf("  Bolshoe TO: -12000 rub. (razoviy platezh)\n");
        }
    }
}


void alice_sell_car(int year, int month) {

    if (alice.pvz.is_open && alice.pvz.months_since_opening == 6 && alice.car.has_car) {

        RUB sale_price = 600000;
        alice.cash += sale_price;

        alice.car.has_car = false;
        alice.car.payment = 0;
        alice.car.fuel = 0;
        alice.car.insurance = 0;
        alice.car.maintenance = 0;
        alice.car.tax = 0;

        alice.expenses.transport = 2860;

        printf("  [МАШИНА] Alice продала машину за %llu rub.\n", sale_price);
        printf("           Переходит на метро (transport: %llu rub/мес)\n", alice.expenses.transport);
    }
}

void alice_buy_apartment(int year, int month) {
    if (year == 2039 && month == 1 && !alice.mortgage.has_mortgage) {

        RUB available_funds = alice.savings_account + alice.cash;

        if (available_funds >= 1500000) {

            if (alice.savings_account >= 1500000) {
                alice.savings_account -= 1500000;
            }
            else {

                RUB deficit = 1500000 - alice.savings_account;
                alice.savings_account = 0;
                alice.cash -= deficit;
            }

            alice.mortgage.has_mortgage = true;
            alice.mortgage.months_paid = 0;
            alice.mortgage.monthly_payment = 50000;
            alice.mortgage.property_value = 8000000;
            alice.mortgage.down_payment = 1500000;


            alice.expenses.rent = 0;

            printf("  [КВАРТИРА] Alice kupila kvartiru v ipoteku!\n");
            printf("             Vznos: 1.5 mln rub.\n");
            printf("             Platezh: 50000 rub/мес\n");
            printf("             Stoimost: 8 mln rub.\n");
            printf("             Arenda obnulena!\n");
        }
        else {
            printf("  [КВАРТИРА] Ne hvataet deneg na pervonachalny vznos!\n");
            printf("             Nuzhno 1.5 mln, est vseh aktivov: %llu\n", available_funds);
        }
    }

    if (alice.mortgage.has_mortgage) {
        alice.mortgage.months_paid++;

        if (alice.mortgage.months_paid >= alice.mortgage.total_months) {
            alice.mortgage.monthly_payment = 0;
            printf("  [КВАРТИРА] Ipoteka vyplachena! Kvartira polnostyu ego.\n");
        }

        if (alice.mortgage.months_paid > 0 && alice.mortgage.months_paid % 12 == 0) {
            RUB repair = 60000;
            alice.cash -= repair;
            printf("  [КВАРТИРА] Remont v kvartire: -%llu rub.\n", repair);
        }
    }
}

void alice_pet() {
    if (alice.months_worked == 18 && !alice.pet.is_alive) {
        alice.pet.is_alive = true;
        alice.pet.age_months = 0;
        alice.pet.food_cost = 3000;
        alice.pet.vet_cost = 800;
        printf("  Alice zavela sobaku!\n");
    }

    if (alice.pet.is_alive) {
        alice.pet.age_months++;

        if (alice.pet.age_months > alice.pet.max_age_months * 0.7) {
            alice.pet.vet_cost = 2500;
        }

        if (alice.pet.age_months >= alice.pet.max_age_months) {
            alice.pet.is_alive = false;
            alice.pet.food_cost = 0;
            alice.pet.vet_cost = 0;
            printf("  Sobachka ymerla v vozraste %d let.\n", alice.pet.age_months / 12);
        }
    }
}


void alice_pvz_logic(int year, int month) {
    if (year == 2037 && month == 1 && alice.is_employed && !alice.pvz.is_open) {
        alice.is_employed = false;
        alice.salary = 0;
        alice.pvz.is_open = true;
        alice.pvz.months_since_opening = 0;
        alice.pvz.rent = 35000;
        alice.pvz.monthly_income = 0;
        alice.pvz.employee_salary = 0;
        alice.pvz.has_employee = false;
        alice.pvz.total_fines = 0;
        alice.pvz.fines_count = 0;

        printf("\n  [ПВЗ] Alice уволилась и открыла пункт выдачи Wildberries!\n");
        printf("        Аренда помещения: %llu rub/мес\n", alice.pvz.rent);
    }

    if (alice.pvz.is_open) {
        alice.pvz.months_since_opening++;

        if (alice.pvz.months_since_opening <= 3) {
            int injury_seed = (month * 17 + year) % 100;
            if (injury_seed < 10) {
                alice.health_points -= 15;
                printf("  [ПВЗ] Alice nadorvala spinu ot tyazhelogo truda! HP: %d\n", alice.health_points);
            }
            alice.pvz.monthly_income = 55000;
        }
        else if (alice.pvz.months_since_opening == 4 && !alice.pvz.has_employee) {
            alice.pvz.has_employee = true;
            alice.pvz.employee_salary = 40000;
            printf("  [ПВЗ] Alice nanyala rabotnika! Zarplata: %llu rub/мес\n", alice.pvz.employee_salary);
            alice.pvz.monthly_income = 120000;  
        }
        else if (alice.pvz.has_employee) {
            int season_bonus = (month == 11 || month == 12) ? 50000 : 0;
            alice.pvz.monthly_income = 180000 + season_bonus;  
        }

        if (alice.pvz.months_since_opening > 0 && alice.pvz.months_since_opening % 12 == 0) {
            alice.pvz.monthly_income = (RUB)(alice.pvz.monthly_income * 1.12);
            alice.pvz.employee_salary = (RUB)(alice.pvz.employee_salary * 1.05);
            printf("  [ПВЗ] Biznes rastet! Dohod: %llu, Zarplata rabotnika: %llu\n",
                alice.pvz.monthly_income, alice.pvz.employee_salary);
        }

        int fine_seed = (month * 23 + year) % 100;
        if (fine_seed < 5) {
            RUB fine = 3000 + ((month * 31 + year) % 7000);
            alice.pvz.total_fines += fine;
            alice.pvz.fines_count++;
            alice.cash -= fine;
            printf("  [ПВЗ] Shtraf za brak tovara: -%llu rub. (vsego shtrafov: %d)\n", fine, alice.pvz.fines_count);
        }
    }
}

void alice_second_job_logic(int year, int month) {

    if (alice.pvz.is_open && alice.pvz.months_since_opening == 3 && !alice.has_second_job) {
        alice.has_second_job = true;
        alice.months_at_second_job = 0;


        int luck = (month * 41 + year) % 61;
        alice.second_job_salary = 90000 + luck * 1000;

        printf("  [ВТОРАЯ РАБОТА] Alice uстроилась на вторую работу!\n");
        printf("                  Zarplata: %llu rub/мес (udacha: %d)\n",
            alice.second_job_salary, luck);
    }

    if (alice.has_second_job) {
        alice.months_at_second_job++;

        if (alice.months_at_second_job > 0 && alice.months_at_second_job % 12 == 0) {
            alice.second_job_salary = (RUB)(alice.second_job_salary * 1.08);
            printf("  [ВТОРАЯ РАБОТА] Индексация зарплаты! Новая: %llu rub.\n",
                alice.second_job_salary);
        }
    }
}

void alice_healthy_food() {
    if (alice.health_points < 60) {
        alice.expenses.healthy_food = 5000;
        alice.expenses.junk_food = 500;
        alice.health_points += 3;
    }
    else if (alice.health_points < 80) {
        alice.expenses.healthy_food = 3000;
        alice.expenses.junk_food = 1000;
        alice.health_points += 1;
    }
    else {
        alice.expenses.healthy_food = 2500;
        alice.expenses.junk_food = 1000;
        alice.health_points += 1;
    }

    if (alice.health_points > 100) alice.health_points = 100;
    if (alice.health_points < 0) alice.health_points = 0;
}

void alice_medical_expenses() {
    alice.months_since_last_checkup++;

    if (alice.health_points < 50 && alice.months_since_last_checkup > 3) {
        RUB medical_cost = (50 - alice.health_points) * 200;
        alice.cash -= medical_cost;
        alice.health_points += 10;
        alice.months_since_last_checkup = 0;
        printf(" Lechenie: -%llu rub. HP: %d -> %d\n", medical_cost, alice.health_points - 10, alice.health_points);
    }

    if (alice.months_since_last_checkup >= 12) {
        alice.cash -= 3000;
        alice.months_since_last_checkup = 0;
    }
}

void alice_random_events(int month) {
    int seed = month * 31 + stats.year;
    int event = seed % 100;

    if (event < 3) {
        RUB medical = 800 + (seed % 2000);
        alice.cash -= medical;
        alice.health_points -= 8;
        printf("  Alice zabolela! Lechenie: -%llu rub.\n", medical);
    }
    else if (event < 5) {
        RUB repair = 2000 + (seed % 3000);
        alice.cash -= repair;
        printf("  Slomalas tekhnika. Remont: -%llu rub.\n", repair);
    }
    else if (event < 10) {
        RUB gift = 5000 + (seed % 10000);
        alice.cash += gift;
        stats.total_income += gift;
        printf("  Rodstvenniki podarili %llu rub.!\n", gift);
    }
    else if (event < 15 && alice.is_employed) {
        alice.salary += 7000;
        printf("  Povysili zarplatu! Novaya: %llu rub.\n", alice.salary);
    }
}

void alice_career_growth(int year, int month) {
    if (year == 2029 && month == 1 && alice.is_employed) {
        alice.salary = 100000;
        printf("  Povyshenie! Zarplata: %llu rub.\n", alice.salary);
    }
    if (year == 2030 && month == 1 && alice.is_employed) {
        alice.salary = 120000;
        printf("  Ypa! Novoe povyshenie! Zarplata: %llu rub.\n", alice.salary);
    }
    if (year == 2035 && month == 1 && alice.is_employed) {
        alice.salary = 160000;
        printf("  Ypa bolshe deneg! Zarplata: %llu rub.\n", alice.salary);
    }
}

void alice_process_time_events(int year, int month) {
    if (alice.months_worked == 3) {
        alice.is_employed = true;
        alice.salary = 80000;
        printf("  Alica proshla stazhirovky! Alicy vzali na raboty! Zarp: %llu rub.\n", alice.salary);
    }
}


void alice_print_month(int year, int month, RUB total_exp) {
    printf("God: %d, Mes: %2d | Work: %s | Cash: %8llu | HP: %2d\n",
        year, month,
        alice.is_employed ? "Da" : "Net",
        alice.cash,
        alice.health_points);
}

void alice_print_yearly_summary() {

    RUB current_monthly = alice.expenses.food + alice.expenses.healthy_food + alice.expenses.junk_food +
        alice.expenses.utilities + alice.expenses.transport + alice.expenses.entertainment +
        alice.expenses.gifts_fund + alice.expenses.rent +
        alice.car.payment + alice.car.fuel + alice.car.insurance + alice.car.maintenance + alice.car.tax +
        alice.pet.food_cost + alice.pet.vet_cost;

    if (alice.mortgage.has_mortgage) {
        current_monthly += alice.mortgage.monthly_payment;
    }

    RUB estimated_yearly = current_monthly * 12;

    printf("\n          %d GOD\n", stats.year);
    printf("Dohod:        %llu rub.\n", stats.total_income);
    printf("Rashod (primerno za god): %llu rub.\n", estimated_yearly);
    printf("  (vkluchaya arendu, mashinu, pitomca i edu)\n");
    printf("Saldo za god: %lld rub.\n", (long long)(stats.total_income - estimated_yearly));
}

void alice_print_final() {
    printf(" Itog\n");
    printf("Nalichnye:        %llu rub.\n", alice.cash);
    printf("Nakopleniya:      %llu rub.\n", alice.savings_account);
    printf("Vsego:            %llu rub.\n", alice.cash + alice.savings_account);
    printf("Zarplata:         %llu rub.\n", alice.salary);
