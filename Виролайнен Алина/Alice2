    printf("Zdorove (HP):     %d / 100\n", alice.health_points);
    printf("Stazh:            %d mesyacev (%d let)\n", alice.months_worked, alice.months_worked / 12);
    if (alice.mortgage.has_mortgage) {
        printf("  Stoimost:       %llu rub.\n", alice.mortgage.property_value);
        printf("  Viplacheno:     %d iz %d mesyacev\n",
            alice.mortgage.months_paid, alice.mortgage.total_months);
    }

    RUB total_wealth = alice.cash + alice.savings_account;
    if (alice.mortgage.has_mortgage) {
