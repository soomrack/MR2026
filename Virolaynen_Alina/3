            RUB education_deduction = (RUB)(education_deduction_base * 0.13);
            total_deduction += education_deduction;

            printf("  [НАЛОГ БОБ] Вычет за обучение: %llu руб.\n", education_deduction);
        }

        RUB actual_refund = 0;

        if (total_deduction < bob.total_ndfl_paid_year) {
            actual_refund = total_deduction;
        }
        else {
            actual_refund = bob.total_ndfl_paid_year;
        }

        if (actual_refund > 0) {
            bob.cash += actual_refund;

            printf("  [НАЛОГ БОБ] Итого возврат НДФЛ: +%llu руб.\n", actual_refund);
