    if (wedding.is_divorced) {
        printf("\nВЫВОД: Боб разведен. Он начал с %llu руб., а закончил с %llu руб.\n",
            wedding.bob_pre_marital, bob_total_wealth);
        if (bob_total_wealth < wedding.bob_pre_marital) {
            printf("       Лудомания и развод серьезно ударили по его финансам.\n");
        }
    }
}


void final_simulation_verdict() {
    printf("\n\n");
    printf("                  ОБЩИЙ ВЕРДИКТ СИМУЛЯЦИИ                     \n");


    if (wedding.is_divorced) {
        printf("  Статус: РАЗВЕДЕНЫ. Причина: %s\n",
            wedding.divorce_reason_code == 1 ? "Лудомания Боба" : "Неизвестна");
        printf("  Имущественный спор решен по ст. 34, 36 СК РФ (50/50).  \n");
    }
    else if (wedding.is_done) {
        printf(" Статус: В БРАКЕ. Семейный бюджет функционирует.         \n");
    }
    else {
        printf("  Статус: НЕ ПОЖЕНИЛИСЬ. Живут раздельной жизнью.         \n");
    }
}


