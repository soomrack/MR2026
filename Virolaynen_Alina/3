void alice_process_expenses() {
    RUB total_expenses = get_current_monthly_expenses();

    if (alice.cash < total_expenses) {
        RUB deficit = total_expenses - alice.cash;

        printf("  [МИНУС] Не хватает %llu руб. на карте\n", deficit);

        if (alice.savings_account >= deficit) {
            alice.savings_account -= deficit;
            alice.cash = 0;
            printf("  [СБЕРЕЖЕНИЯ] Покрыли минус со сбережений: -%llu руб.\n", deficit);
