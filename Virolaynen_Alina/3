        RUB medical_deduction_base = 0;

        if (bob.medical_expenses_year < medical_limit) {
            medical_deduction_base = bob.medical_expenses_year;
        }
        else {
            medical_deduction_base = medical_limit;
        }

        RUB medical_deduction = (RUB)(medical_deduction_base * 0.13);
        total_deduction += medical_deduction;

        printf("  [НАЛОГ БОБ] Социальный вычет (лечение): %llu руб.\n", medical_deduction);

        if (bob.education_expenses_year > 0) {
            RUB education_limit = 50000;
