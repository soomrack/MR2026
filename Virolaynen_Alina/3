void calculate_wedding_cost() {
    wedding.venue_rent = 150000;
    wedding.food_per_guest = 4500;

    RUB total_food = wedding.food_per_guest * wedding.guest_count;

    wedding.host_fee = 80000;
    wedding.photographer = 60000;
    wedding.videographer = 70000;
    wedding.dj_music = 50000;

    wedding.bride_dress = 120000;
    wedding.groom_suit = 60000;
    wedding.makeup_hair = 25000;

    wedding.decorations = 90000;
    wedding.flowers = 110000;

    wedding.welcome_gifts = 500 * wedding.guest_count;
    wedding.wedding_cake = 40000;
    wedding.invitations = 200 * wedding.guest_count;
    wedding.wedding_rings = 150000;
    wedding.transport = 70000;

    wedding.total_cost = wedding.venue_rent + total_food + wedding.host_fee +
        wedding.photographer + wedding.videographer +
        wedding.bride_dress + wedding.groom_suit +
        wedding.makeup_hair + wedding.decorations +
        wedding.flowers + wedding.welcome_gifts +
        wedding.wedding_cake + wedding.dj_music +
        wedding.invitations + wedding.wedding_rings +
        wedding.transport;

    printf("  [СВАДЬБА] Бюджет свадьбы рассчитан!\n");
    printf("            Итоговая стоимость: %llu руб.\n", wedding.total_cost);
    printf("            (Только еда на %d гостей обошлась в %llu руб.)\n",
        wedding.guest_count, total_food);
}

void execute_wedding(const int year, const int month) {
    if (year == wedding.wedding_year && month == wedding.wedding_month &&
        wedding.is_planned && !wedding.is_done) {

        wedding.alice_pre_marital = alice.cash + alice.savings_account;
        wedding.bob_pre_marital = bob.cash + bob.savings_account;

        alice.is_married = true;
        bob.is_married = true;

        printf("  [СТАТУС] Элис и Боб официально поженились!\n");
        printf("           Добрачное имущество Элис: %llu руб.\n", wedding.alice_pre_marital);
        printf("           Добрачное имущество Боба: %llu руб.\n", wedding.bob_pre_marital);

        int luck = (year * 13 + month * 7) % 50;
        RUB gift_per_guest = 10000 + luck * 100;
        wedding.total_gifts_received = gift_per_guest * wedding.guest_count;

        printf("  [ПОДАРКИ] Гости подарили в конвертах:\n");
        printf("            %d гостей x %llu руб. = %llu руб.\n",
            wedding.guest_count, gift_per_guest, wedding.total_gifts_received);

        RUB share = wedding.total_cost / 2;

        printf("\n  [РАСХОДЫ] Стоимость свадьбы: %llu руб.\n", wedding.total_cost);
        printf("            Доля Элис: %llu руб.\n", share);
        printf("            Доля Боба: %llu руб.\n", share);

        if (alice.cash >= share) {
            alice.cash -= share;
        }
        else {
            RUB deficit = share - alice.cash;
            alice.cash = 0;
            alice.savings_account -= deficit;
            printf("  [ВНИМАНИЕ] У Элис не хватило наличных, списано со сбережений!\n");
        }

        if (bob.cash >= share) {
            bob.cash -= share;
        }
        else {
            RUB deficit = share - bob.cash;
            bob.cash = 0;
            bob.savings_account -= deficit;
            printf("  [ВНИМАНИЕ] У Боба не хватило наличных, списано со сбережений!\n");
        }

        alice.cash += wedding.total_gifts_received;
        printf("\n  [ИТОГ] Подарки (%llu руб.) зачислены на счет Элис.\n", wedding.total_gifts_received);

        RUB net_wedding_cost = wedding.total_cost - wedding.total_gifts_received;
        printf("\n  [ФИНАНСЫ] Чистые затраты на свадьбу: %llu руб.\n", net_wedding_cost);
        printf("========================================\n\n");

        wedding.is_done = true;
    }
}


