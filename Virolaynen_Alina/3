void bob_gambling(const int month) {
    if (!alice.is_married || wedding.is_divorced) return;

    int seed = month * 31 + stats.year;
    if ((seed % 100) < 3) {

        int outcome = seed % 1000;

        if (outcome < 600) {
            RUB loss = 20000 + (seed % 80000);
            if (loss > 150000) loss = 150000;

            if (bob.savings_account >= loss) {
                bob.savings_account -= loss;
            }

            else {
                bob.savings_account = 0;
            }
            printf("  [КАЗИНО] Боб сходил в казино и проиграл %llu руб.\n", loss);
        }

        else if (outcome < 850) {
            RUB gross_win = 30000 + (seed % 50000);
            RUB gambling_tax = (RUB)(gross_win * 0.13);
            RUB net_win = gross_win - gambling_tax;

            bob.savings_account += net_win;
            printf("  [КАЗИНО] Боб выиграл %llu руб. (налог 13%%: -%llu руб.). На счет: +%llu руб.\n",
                gross_win, gambling_tax, net_win);
        }
        else if (outcome < 990) {
            RUB gross_big_win = 200000 + (seed % 300000);

            RUB gambling_tax = (RUB)(gross_big_win * 0.13);
            RUB net_big_win = gross_big_win - gambling_tax;

            bob.savings_account += net_big_win;
            printf("  [КАЗИНО] НЕВЕРОЯТНАЯ УДАЧА! Боб выиграл %llu руб. в казино!\n", gross_big_win);
            printf("           Удержан налог на выигрыш (13%%): -%llu руб.\n", gambling_tax);
            printf("           Чистый выигрыш на счет: +%llu руб.\n", net_big_win);
            printf("           Элис в восторге, семейный бюджет значительно пополнен.\n");
        }

        else {
            RUB loss = 500000;
            printf("  [КАЗИНО] Боб проиграл %llu руб. в казино! Элис узнала об этом!\n", loss);

            execute_divorce(1);
        }
    }
}


