void calculate_child_expenses() {
    if (!child.is_born) return;

    child.diaper_cost = 0;
    child.baby_food_cost = 0;
    child.medical_cost = 0;
    child.clothing_cost = 0;
    child.kindergarten_cost = 0;
    child.school_cost = 0;
    child.toy_cost = 0;

    if (child.age_months < 24) {
        child.diaper_cost = 4000; 
        child.baby_food_cost = 6000;
        child.medical_cost = 3000;  
        child.clothing_cost = 2000; 
        child.toy_cost = 1500; 
    }

    else if (child.age_months < 36) {
        child.diaper_cost = 2000;    
        child.baby_food_cost = 8000;
        child.medical_cost = 3000;
        child.clothing_cost = 2500;
        child.toy_cost = 2000;
    }

    else if (child.age_months < 84) {
        child.baby_food_cost = 9000;
        child.medical_cost = 3000;
        child.clothing_cost = 3000;
        child.kindergarten_cost = 15000;
        child.toy_cost = 2500;
    }

    else if (child.age_months < 216) {
        child.baby_food_cost = 12000;
        child.medical_cost = 4000;
        child.clothing_cost = 5000;
        child.school_cost = 20000;
        child.toy_cost = 3000;
    }

    child.total_monthly_cost = child.diaper_cost + child.baby_food_cost +
        child.medical_cost + child.clothing_cost +
        child.kindergarten_cost + child.school_cost +
        child.toy_cost;

    if (child.age_months % 12 == 0) {
        printf("  [РЕБЕНОК] %s: %d лет. Ежемесячные расходы: %llu руб.\n",
            child.name, child.age_months / 12, child.total_monthly_cost);
    }
}


void child_random_events(const int month) {
    if (!child.is_born) return;

    int seed = month * 47 + stats.year + child.age_months;
    int event = seed % 100;

    if (child.age_months < 60 && event < 15) {
        int illness_type = seed % 4;

        if (illness_type == 0) {

            RUB medical_cost = 8000;
            printf("  [РЕБЕНОК] %s заболел ветрянкой! Лечение: -%llu руб.\n", child.name, medical_cost);

            if (wedding.joint_savings >= medical_cost) {
                wedding.joint_savings -= medical_cost;
            }

            else if (alice.savings_account >= medical_cost) {
                alice.savings_account -= medical_cost;
            }

            else {
                printf("  [КРИЗИС] Нет денег на лечение ребенка!\n");
            }
        }

        else if (illness_type == 1) {
            RUB medical_cost = 5000;
            printf("  [РЕБЕНОК] %s заболел гриппом. Лечение: -%llu руб.\n", child.name, medical_cost);

            if (wedding.joint_savings >= medical_cost) {
                wedding.joint_savings -= medical_cost;
            }

            else if (alice.savings_account >= medical_cost) {
                alice.savings_account -= medical_cost;
            }
        }

        else if (illness_type == 2) {
            RUB medical_cost = 12000;
            printf("  [РЕБЕНОК] %s получил травму! Срочное лечение: -%llu руб.\n", child.name, medical_cost);

            if (wedding.joint_savings >= medical_cost) {
                wedding.joint_savings -= medical_cost;
            }
            else if (alice.savings_account >= medical_cost) {
                alice.savings_account -= medical_cost;
            }
        }
        else {
            RUB medical_cost = 6000;
            printf("  [РЕБЕНОК] У %s обострение аллергии. Лечение: -%llu руб.\n", child.name, medical_cost);

            if (wedding.joint_savings >= medical_cost) {
                wedding.joint_savings -= medical_cost;
            }
            else if (alice.savings_account >= medical_cost) {
                alice.savings_account -= medical_cost;
            }
        }
    }

    if (child.age_months == 12) {
        printf("  [РЕБЕНОК] %s сделал первые шаги! Семья счастлива!\n", child.name);
