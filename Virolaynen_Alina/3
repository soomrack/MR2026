RUB calculate_ndfl(RUB annual_income) {
    RUB ndfl = 0;

    RUB threshold_1 = 2400000;  
    RUB threshold_2 = 5000000; 
    RUB threshold_3 = 20000000; 
    RUB threshold_4 = 50000000;  

    if (annual_income <= threshold_1) {

        ndfl = (RUB)(annual_income * 0.13);
    }
    else if (annual_income <= threshold_2) {

        ndfl = (RUB)(threshold_1 * 0.13);
        ndfl += (RUB)((annual_income - threshold_1) * 0.15);
    }
    else if (annual_income <= threshold_3) {

        ndfl = (RUB)(threshold_1 * 0.13);
        ndfl += (RUB)((threshold_2 - threshold_1) * 0.15);
        ndfl += (RUB)((annual_income - threshold_2) * 0.18);
    }
    else if (annual_income <= threshold_4) {

        ndfl = (RUB)(threshold_1 * 0.13);
        ndfl += (RUB)((threshold_2 - threshold_1) * 0.15);
        ndfl += (RUB)((threshold_3 - threshold_2) * 0.18);
        ndfl += (RUB)((annual_income - threshold_3) * 0.20);
    }
    else {
        // Все 5 ставок
        ndfl = (RUB)(threshold_1 * 0.13);
        ndfl += (RUB)((threshold_2 - threshold_1) * 0.15);
        ndfl += (RUB)((threshold_3 - threshold_2) * 0.18);
        ndfl += (RUB)((threshold_4 - threshold_3) * 0.20);
        ndfl += (RUB)((annual_income - threshold_4) * 0.22);
    }

    return ndfl;
}


void alice_process_income(const int month) {

    if (alice.is_on_maternity_leave) {
        alice.cash += alice.maternity_allowance;
        stats.total_income += alice.maternity_allowance;
        return;
    }

    if (alice.months_worked < 3) {
        alice.cash += alice.parental_support;
        stats.total_income += alice.parental_support;
    }
    else {
        alice.parental_support = 0;
    }

    if (alice.is_employed) {

        RUB ndfl = calculate_ndfl(alice.salary);
        RUB net_salary = alice.salary - ndfl;

        alice.cash += net_salary;
        stats.total_income += alice.salary;

        alice.total_ndfl_paid_year += ndfl;

        if (alice.months_worked > 0 && alice.months_worked % 2 == 0) {
            RUB bonus_gross = 20000;
            RUB bonus_ndfl = calculate_ndfl(bonus_gross);
            RUB bonus_net = bonus_gross - bonus_ndfl;

            alice.cash += bonus_net;
            stats.total_income += bonus_gross;
            alice.total_ndfl_paid_year += bonus_ndfl;
        }
    }

    if (alice.pvz.is_open) {
        RUB pvz_tax = (RUB)(alice.pvz.monthly_income * 0.06);
        RUB pvz_net = alice.pvz.monthly_income - pvz_tax;

        alice.cash += pvz_net;
        stats.total_income += alice.pvz.monthly_income;
    }

    if (alice.has_second_job) {
        RUB ndfl2 = calculate_ndfl(alice.second_job_salary);
        RUB net_salary2 = alice.second_job_salary - ndfl2;

        alice.cash += net_salary2;
        stats.total_income += alice.second_job_salary;
        alice.total_ndfl_paid_year += ndfl2;
    }
}


