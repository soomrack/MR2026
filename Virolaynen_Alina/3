void alice_tax_refund(const int month) {

    if (month == 3 && alice.total_ndfl_paid_year > 0) {
        RUB total_deduction = 0;

        RUB medical_limit = 120000;
        RUB medical_deduction_base = 0;

        if (alice.medical_expenses_year < medical_limit) {
            medical_deduction_base = alice.medical_expenses_year;
        }
        else {
            medical_deduction_base = medical_limit;
        }

        RUB medical_deduction = (RUB)(medical_deduction_base * 0.13);
        total_deduction += medical_deduction;

        printf("  [НАЛОГ] Социальный вычет (лечение): %llu руб.\n", medical_deduction);

        if (alice.property_deduction_remaining > 0) {
            RUB property_deduction = (RUB)(alice.property_deduction_remaining * 0.13);
            total_deduction += property_deduction;

            printf("  [НАЛОГ] Имущественный вычет (квартира): %llu руб.\n", property_deduction);
        }

        if (alice.mortgage_interest_deduction_remaining > 0) {
            RUB interest_deduction = (RUB)(alice.mortgage_interest_deduction_remaining * 0.13);
            total_deduction += interest_deduction;

            printf("  [НАЛОГ] Вычет по процентам ипотеки: %llu руб.\n", interest_deduction);
        }

        RUB actual_refund = 0;

        if (total_deduction < alice.total_ndfl_paid_year) {
            actual_refund = total_deduction;
        }
        else {
            actual_refund = alice.total_ndfl_paid_year;
        }

        if (actual_refund > 0) {
            alice.cash += actual_refund;

            printf("  [НАЛОГ] Итого возврат НДФЛ: +%llu руб.\n", actual_refund);
            printf("           (уплачено НДФЛ за год: %llu руб.)\n", alice.total_ndfl_paid_year);

            if (alice.property_deduction_remaining > 0) {
                RUB property_used = (RUB)(alice.property_deduction_remaining * 0.13);
                if (property_used <= actual_refund) {
                    alice.property_deduction_remaining = 0;
                }
                else {
                    RUB remaining_after_property = actual_refund - property_used;
                    alice.property_deduction_remaining -= (RUB)(property_used / 0.13);
                }
            }

            if (alice.mortgage_interest_deduction_remaining > 0) {
                RUB interest_used = (RUB)(alice.mortgage_interest_deduction_remaining * 0.13);
                if (interest_used <= actual_refund) {
                    alice.mortgage_interest_deduction_remaining = 0;
                }
                else {
                    alice.mortgage_interest_deduction_remaining -= (RUB)(interest_used / 0.13);
                }
            }
        }
        else {
            printf("  [НАЛОГ] Возврат не положен (недостаточно уплаченного НДФЛ)\n");
        }

        alice.medical_expenses_year = 0;
        alice.total_ndfl_paid_year = 0;
    }
}


