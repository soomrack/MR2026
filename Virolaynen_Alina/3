void alice_process_month_end(int* year,int* month) {

    RUB monthly_exp = get_current_monthly_expenses();
    RUB smart_buffer = monthly_exp + 50000;

    if (alice.cash > smart_buffer) {
        RUB to_save = alice.cash - smart_buffer;
        alice.cash -= to_save;
        alice.savings_account += to_save;
    }

    alice.months_worked++;
    ++(*month);

    if (*month == 13) {
        alice_print_yearly_summary();
        apply_yearly_inflation();
        ++(*year);
        *month = 1;
        stats_reset_for_year(*year);
    }
}


