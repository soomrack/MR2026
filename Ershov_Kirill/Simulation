// ДЕНЬГИ
bool pay(RUB amount) {
    if (Kirill.cash >= amount) {
        Kirill.cash -= amount;
        return true;
    }
    RUB need = amount - Kirill.cash;
    if (Kirill.bank.savings >= need) {
        Kirill.bank.savings -= need;
        Kirill.cash = 0;
        return true;
    }
    Kirill.unpaid += need - Kirill.bank.savings;
    Kirill.cash = 0;
    Kirill.bank.savings = 0;
    return false;
}

// РАБОТА: ставки и расчёты
double stavka_po_razryadu(int r) {
    switch (r) {
    case 1: return 380.0;
    case 2: return 450.0;
    case 3: return 530.0;
    case 4: return 620.0;
    case 5: return 720.0;
    case 6: return 840.0;
    }
    return 450.0;
}

void proverit_razryad(int year, int month) {
    if (month != 1) return;
    if (rabota.sokratili) return;
    if (year % 2 != 0) return;

    int chance = 30 + rabota.staj * 5;
    if (chance > 80) chance = 80;

    if (rand100() <= chance and rabota.razryad < 6) {
        rabota.razryad++;
        rabota.stavka = stavka_po_razryadu(rabota.razryad);
    }
}

RUB rasschitat_zarplatu(int year, int month) {
    if (rabota.sokratili) return 0;

    double chasov = rabota.norm_chasov;

    double nochnaya_nadbavka = 0.0;
    if (rabota.nochnaya_smena) {
        nochnaya_nadbavka = 0.4 * rabota.stavka * 40;
    }

    double sverh = 0.0;
    if (rabota.sverhurochnyh > 0) {
        int pervyh = std::min(rabota.sverhurochnyh, 2);
        int ostalnyh = rabota.sverhurochnyh - pervyh;
        sverh = pervyh * rabota.stavka * 1.5 + ostalnyh * rabota.stavka * 2.0;
    }

    double osnovnaya = chasov * rabota.stavka;

    double premiya_procent = 0.0;
    if (month == 12) premiya_procent = 0.30;
    else if (month == 3 or month == 6 or month == 9) premiya_procent = 0.15;
    else premiya_procent = 0.05;

    rabota.premiya = (RUB)(osnovnaya * premiya_procent);

    double raionnyj = 1.15;
    double profsoyuz = rabota.profsoyuz ? 0.01 : 0.0;

    double itogo = (osnovnaya + nochnaya_nadbavka + sverh) * raionnyj;
    itogo = itogo * (1.0 - profsoyuz) + rabota.premiya;

    if (year == 2029 or year == 2033) {
        RUB zaderzhka = (RUB)(itogo * 0.20);
        rabota.dolg_po_zarplate += zaderzhka;
        itogo -= zaderzhka;
    }

    return (RUB)itogo;
}

void proverit_sokrashchenie(int year, int month) {
    if (month != 1) return;
    if (rabota.sokratili) return;

    int risk = 0;
    if (year == 2029) risk = 15;
    if (year == 2033) risk = 20;
    if (year == 2030 or year == 2034) risk = 5;

    if (risk > 0 and rand100() <= risk) {
        rabota.sokratili = true;
    }
}

void otpusknye(int year, int month) {
    if (month != 7) return;
    if (rabota.sokratili) return;
    if (rabota.otpusknyh_dney < 14) return;

    RUB srednyaya = (RUB)(rabota.norm_chasov * rabota.stavka * 1.15);
    RUB otpusk = srednyaya * 14 / 30;

    Kirill.cash += otpusk;
    rabota.otpusknyh_dney -= 14;
    vsego_na_rabotu += otpusk;
}

void bolnichnyj(int year, int month) {
    if (rabota.sokratili) return;
    if (rand100() > 5) return;
    if (rabota.bolnichnyh_dney <= 0) return;

    int dney = 3 + rand100() % 7;
    if (dney > rabota.bolnichnyh_dney) dney = rabota.bolnichnyh_dney;

    RUB vyplata = (RUB)(dney * rabota.stavka * 0.6);
    Kirill.cash += vyplata;
    rabota.bolnichnyh_dney -= dney;
}

void rabota_mesyac(int year, int month) {
    if (month == 1) {
        rabota.staj++;
        rabota.otpusknyh_dney = std::min(rabota.otpusknyh_dney + 28, 56);
        rabota.bolnichnyh_dney = std::min(rabota.bolnichnyh_dney + 10, 30);
    }

    if (month == 12 or month <= 2) {
        rabota.nochnaya_smena = (rand100() < 60);
        rabota.sverhurochnyh = 5 + rand100() % 15;
    }
    else if (month >= 6 and month <= 8) {
        rabota.nochnaya_smena = (rand100() < 20);
        rabota.sverhurochnyh = rand100() % 5;
    }
    else {
        rabota.nochnaya_smena = (rand100() < 40);
        rabota.sverhurochnyh = rand100() % 10;
    }

    proverit_razryad(year, month);
    proverit_sokrashchenie(year, month);
    otpusknye(year, month);
    bolnichnyj(year, month);

    RUB zarplata = rasschitat_zarplatu(year, month);
    Kirill.cash += zarplata;
    Kirill.salary = zarplata;

    vsego_na_rabotu += zarplata;
}

// ИПОТЕКА: расчёт
RUB rasschitat_platezh(RUB dolg, double stavka, int let) {
    double m = stavka / 12.0;
    double n = let * 12.0;
    double koef = (m * pow(1.0 + m, n)) / (pow(1.0 + m, n) - 1.0);
    return (RUB)(dolg * koef);
}

struct RazborPlatezha {
    RUB procenty;
    RUB telo;
};

RazborPlatezha razobrat_platezh(RUB dolg, double stavka, RUB platezh) {
    RazborPlatezha r;
    r.procenty = (RUB)(dolg * stavka / 12.0);
    r.telo = platezh - r.procenty;
    if (r.telo > dolg) r.telo = dolg;
    return r;
}

void proverit_refinansirovanie(int year, int month) {
    if (!ipoteka.aktivna) return;
    if (month != 1) return;
    if (ipoteka.refi_god > 0 and year - ipoteka.refi_god < 3) return;

    double rynok = 0.13;
    if (year >= 2028) rynok = 0.11;
    if (year >= 2031) rynok = 0.09;
    if (year >= 2034) rynok = 0.07;

    if (rynok < ipoteka.stavka - 0.01) {
        ipoteka.stavka = rynok;
        int ostalo_let = ipoteka.srok_let - ipoteka.mesyacev_vyplacheno / 12;
        if (ostalo_let < 1) ostalo_let = 1;
        ipoteka.platezh = rasschitat_platezh(ipoteka.ostatok, ipoteka.stavka, ostalo_let);
        ipoteka.refi_god = year;
    }
}

void dosrochnoe_pogashenie(int year, int month) {
    if (!ipoteka.aktivna) return;
    if (month != 12) return;

    RUB svobodno = Kirill.cash;
    RUB rezerv = Kirill.salary * 2;
    if (svobodno <= rezerv) return;

    RUB na_dosrochku = svobodno - rezerv;
    RUB max_dosrochka = ipoteka.ostatok / 10;
    if (na_dosrochku > max_dosrochka) na_dosrochku = max_dosrochka;

    Kirill.cash -= na_dosrochku;
    ipoteka.ostatok -= na_dosrochku;
    ipoteka.dosrochno_za_god += na_dosrochku;
    vsego_dosrochno += na_dosrochku;

    int ostalo_let = ipoteka.srok_let - ipoteka.mesyacev_vyplacheno / 12;
    if (ostalo_let < 1) ostalo_let = 1;
    ipoteka.platezh = rasschitat_platezh(ipoteka.ostatok, ipoteka.stavka, ostalo_let);
}

void strahovka(int year, int month) {
    if (!ipoteka.aktivna) return;
    if (month != 1) return;
    if (ipoteka.ostatok <= 0) return;

    RUB strah = (RUB)(ipoteka.summa * 0.008);
    Kirill.cash -= strah;
    ipoteka.strahovka_v_god = strah;
}

void nalogovyj_vychet(int year, int month) {
    if (!ipoteka.aktivna) return;
    if (month != 1) return;
    if (year == ipoteka.refi_god) return;

    if (ipoteka.vychet_osnovnoj < 2'000'000) {
        RUB ostatok_vycheta = 2'000'000 - ipoteka.vychet_osnovnoj;
        RUB za_god = std::min(ostatok_vycheta, Kirill.salary * 12);
        RUB vozvrat = (RUB)(za_god * 0.13);
        Kirill.cash += vozvrat;
        ipoteka.vychet_osnovnoj += za_god;
        ipoteka.vozvrat_ozhidaetsya += vozvrat;
    }

    if (ipoteka.vychet_procenty < 3'000'000) {
        RUB procenty_za_god = (RUB)(ipoteka.ostatok * ipoteka.stavka);
        RUB ostatok_limita = 3'000'000 - ipoteka.vychet_procenty;
        RUB za_god = std::min(procenty_za_god, ostatok_limita);
        RUB vozvrat = (RUB)(za_god * 0.13);
        Kirill.cash += vozvrat;
        ipoteka.vychet_procenty += za_god;
        ipoteka.vozvrat_ozhidaetsya += vozvrat;
    }
}

void ipoteka_mesyac(int year, int month) {
    if (year == 2031 and month == 1) {
        ipoteka.aktivna = true;
        ipoteka.ostatok = ipoteka.summa;
        ipoteka.platezh = rasschitat_platezh(ipoteka.summa, ipoteka.stavka, ipoteka.srok_let);
        ipoteka.mesyacev_vyplacheno = 0;
        ipoteka.vychet_osnovnoj = 0;
        ipoteka.vychet_procenty = 0;
        ipoteka.vozvrat_ozhidaetsya = 0;
        ipoteka.dosrochno_za_god = 0;
    }

    if (!ipoteka.aktivna) return;
    if (ipoteka.ostatok <= 0) return;

    proverit_refinansirovanie(year, month);
    strahovka(year, month);
    nalogovyj_vychet(year, month);

    RazborPlatezha r = razobrat_platezh(ipoteka.ostatok, ipoteka.stavka, ipoteka.platezh);

    if (Kirill.cash >= ipoteka.platezh) {
        Kirill.cash -= ipoteka.platezh;
        ipoteka.ostatok -= r.telo;
        if (ipoteka.ostatok < 0) ipoteka.ostatok = 0;
        ipoteka.mesyacev_vyplacheno++;
        vsego_procentov += r.procenty;
    }
    else {
        Kirill.unpaid += ipoteka.platezh;
    }

    dosrochnoe_pogashenie(year, month);
}

// ЕДА
void snacks(int month) {
    int days = 30;
    if (month == 2) days = 28;
    else if (month == 1 or month == 3 or month == 5 or month == 7
        or month == 8 or month == 10 or month == 12) days = 31;

    spends.snacks = 0;
    for (int d = 1; d <= days; ++d) {
        if (rand100() < 20) spends.snacks += spends.snack_price;
    }
}

void eda(int month) {
    spends.food = 11'000;
    spends.snack_price = 300;
    snacks(month);
    pay(spends.food);
    pay(spends.snacks);
    vsego_edy += spends.food + spends.snacks;
}

// КОММУНАЛКА
void kommunalka(int year, int month) {
    if (year < 2031) return;

    RUB hw = 150;
    RUB cw = 45;
    RUB el = 7;
    RUB heat = 2350;
    RUB remont = 30 * 60;

    static std::mt19937 gen(std::random_device{}());
    std::uniform_int_distribution<> cwd(3, 4);
    std::uniform_int_distribution<> hwd(4, 5);
    std::uniform_int_distribution<> ed(75, 110);

    RUB summa = cwd(gen) * cw
        + hwd(gen) * hw
        + ed(gen) * el
        + remont;

    if (month >= 10 or month <= 4) summa += heat;

    pay(summa);
    vsego_kommunalki += summa;
}

// БАНК
void save_part() {
    RUB reserve = Kirill.salary;
    if (Kirill.cash <= reserve) return;
    RUB free = Kirill.cash - reserve;
    RUB target = (RUB)(Kirill.salary * Kirill.bank.save_percent);
    RUB amount = std::min(free, target);
    Kirill.cash -= amount;
    Kirill.bank.savings += amount;
}

void open_deposits(int year, int month) {
    while (Kirill.bank.savings >= Kirill.bank.deposit_threshold
        and Kirill.bank.savings >= 100'000
        and Kirill.bank.deposits.size() < (size_t)Kirill.bank.max_deposits) {
        Deposit d;
        d.amount = 100'000;
        d.balance = 100'000;
        d.open_y = year;
        d.open_m = month;
        int total = (month - 1) + Kirill.bank.deposit_term;
        d.close_y = year + total / 12;
        d.close_m = total % 12 + 1;
        Kirill.bank.deposits.push_back(d);
        Kirill.bank.savings -= 100'000;
    }
}

void accrue_savings() {
    RUB interest = (RUB)(Kirill.bank.savings * Kirill.bank.savings_rate / 12.0);
    Kirill.bank.savings += interest;
}

void accrue_deposits() {
    for (auto& d : Kirill.bank.deposits) {
        RUB interest = (RUB)(d.balance * d.rate / 12.0);
        d.balance += interest;
    }
}

void close_deposits(int year, int month) {
    auto it = Kirill.bank.deposits.begin();
    while (it != Kirill.bank.deposits.end()) {
        if (year == it->close_y and month == it->close_m) {
            Kirill.bank.savings += it->balance;
            it = Kirill.bank.deposits.erase(it);
        }
        else {
            ++it;
        }
    }
}

void banking(int year, int month) {
    save_part();
    accrue_savings();
    accrue_deposits();
    close_deposits(year, month);
    open_deposits(year, month);
}

// НАЛОГИ
RUB ndfl(RUB income) {
    RUB t = 0;
    if (income <= 2'400'000) {
        t = income * 13 / 100;
    }
    else if (income <= 5'000'000) {
        t = 2'400'000 * 13 / 100 + (income - 2'400'000) * 15 / 100;
    }
    else if (income <= 20'000'000) {
        t = 2'400'000 * 13 / 100 + (5'000'000 - 2'400'000) * 15 / 100
            + (income - 5'000'000) * 18 / 100;
    }
    else {
        t = 2'400'000 * 13 / 100 + (5'000'000 - 2'400'000) * 15 / 100
            + (20'000'000 - 5'000'000) * 18 / 100
            + (income - 20'000'000) * 20 / 100;
    }
    return t;
}

void nalog_mesyac(int year) {
    if (Kirill.tax.tax_year != year) {
        Kirill.tax.income = 0;
        Kirill.tax.ndfl_paid = 0;
        Kirill.tax.tax_year = year;
    }
    RUB prev = Kirill.tax.income;
    RUB now = prev + Kirill.salary;
    RUB diff = ndfl(now) - ndfl(prev);
    pay(diff);
    Kirill.tax.income = now;
    Kirill.tax.ndfl_paid += diff;
}

// МАШИНА
int monthly_mileage(int month) {
    int lo, hi;
    if (month == 12 or month <= 2) { lo = 800; hi = 1200; }
    else if (month <= 5) { lo = 600; hi = 1000; }
    else if (month <= 8) { lo = 400; hi = 800; }
    else { lo = 600; hi = 1000; }
    static std::mt19937 gen(std::random_device{}());
    std::uniform_int_distribution<> d(lo, hi);
    return d(gen);
}

void car_month(int year, int month) {
    if (!Kirill.car.exists) {
        RUB price = 1'200'000;
        if (year > 2032
            and (Kirill.cash >= price
                or Kirill.bank.savings >= price - Kirill.cash)) {
            pay(price);
            Kirill.car.exists = true;
            Kirill.car.age = 3;
            Kirill.car.mileage = 94'000;
            Kirill.car.condition = 60;
        }
        else {
            return;
        }
    }

    if (month == 1) {
        Kirill.car.age += 1;
        Kirill.car.fuel_price = (RUB)(Kirill.car.fuel_price * 1.05);
        pay(Kirill.car.annual_insurance);
    }

    int dist = monthly_mileage(month);
    Kirill.car.mileage += dist;
    Kirill.car.condition -= dist / 1000;
    if (Kirill.car.condition < 0) Kirill.car.condition = 0;
    if (Kirill.car.condition > 100) Kirill.car.condition = 100;

    double liters = dist * Kirill.car.fuel_consumption / 100.0;
    spends.fuel = (RUB)(liters * Kirill.car.fuel_price);
    pay(spends.fuel);
    vsego_topliva += spends.fuel;
}

// СИМУЛЯЦИЯ
void run() {
    int year = 2026;
    int month = 9;

    while (!(year == 2036 and month == 9)) {
        rabota_mesyac(year, month);
        nalog_mesyac(year);
        eda(month);
        ipoteka_mesyac(year, month);
        kommunalka(year, month);
        banking(year, month);
        car_month(year, month);

        ++month;
        if (month == 13) { ++year; month = 1; }
    }
}

