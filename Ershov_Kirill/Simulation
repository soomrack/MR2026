        printf("  Вычет по процентам:  %llu\n", ipoteka.vychet_procenty);
        printf("  Страховка в год:     %llu\n", ipoteka.strahovka_v_god);
    }
    else {
        printf("  Ипотека не бралась\n");
    }
    printf("\n");

    printf("ДЕНЬГИ\n");
    printf("  Наличные:            %llu\n", Kirill.cash);
    printf("  Зарплата:            %llu\n", Kirill.salary);
    printf("  Накопления:          %llu\n", Kirill.bank.savings);
    printf("  Вкладов:             %zu\n", Kirill.bank.deposits.size());
    printf("  Сумма вкладов:       %llu\n", dep_total);
    printf("  Всего в банке:       %llu\n\n",
        Kirill.bank.savings + dep_total);

    printf("РАСХОДЫ\n");
    printf("  Еда:                 %lld\n", vsego_edy);
    printf("  Топливо:             %lld\n", vsego_topliva);
    printf("  Коммуналка:          %lld\n", vsego_kommunalki);
    printf("  Неоплачено:          %llu\n\n", Kirill.unpaid);

    printf("МАШИНА\n");
    if (Kirill.car.exists) {
        printf("  Возраст:             %d\n", Kirill.car.age);
        printf("  Пробег:              %d\n", Kirill.car.mileage);
        printf("  Состояние:           %d/100\n", Kirill.car.condition);
    }
    else {
        printf("  Не куплена\n");
    }
}

int main() {
    setup();
    run();
    report();
    return 0;
}
